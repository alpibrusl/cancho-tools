edition 5;

module toolbox.fail;

// `toolbox.fail` -- errors as data (D5), with a repair a script can apply
// (D6).
//
// An error is `{code, rule, message, hint, repair, detail}`, in that order,
// built with a `json.Writer` so it is always a valid object. Independent
// errors are all kept, in input order: `Errors` holds every one, the exit
// code of the first, and a plain-text line per error for `--format text`.
//
// Building one is four calls, in the order the keys appear:
//
//     var e = fail.open(heap, "io.not-found", "the file does not exist", "check the path");
//     e = fail.no_repair(heap, e);           // or repair_none / retry_open..retry_close
//     e = fail.detail_open(heap, e);
//     e = json.put_key(heap, e, "path");
//     e = json.put_string(heap, e, shown);
//     errs = fail.add(heap, errs, e);
//
// With several detail keys, `detail_str`, `detail_int`, `detail_bool` and
// `detail_text` write the key and its value in one call:
//
//     e = fail.detail_open(heap, e);
//     e = fail.detail_text(heap, e, "path", shown);   // text_or_bytes (toolbox.text)
//     e = fail.detail_int(heap, e, "errno", errno);
//
// and `choose_open` .. `choose_close` build a repair that offers several
// retries, for an error whose cure is one of a few (`choose_replacing` does
// one option: the whole invocation with an argument swapped).
//
// A repair never widens authority (D6 rule 1): the only repairs built here
// replace one argument with a spelling the tool itself derived, and the
// callers that build one never add `--root`, a write flag, `--create`, or
// remove `--dry-run`. `tests/conformance/test_rules.py` applies every
// repair by script and checks it succeeds and adds no such flag.

import std.buffer;
import std.json;
import std.vec;
import toolbox.rules;
import toolbox.text;

pub res struct Errors {
    // Every error object, comma-separated: the inside of an array.
    all: buffer.Buffer,
    // `rule: message` per line, for `--format text`.
    lines: buffer.Buffer,
    count: int,
    // The exit code of the first error, 0 when there is none.
    first_exit: int,
    // `all[0..first_end]` is the first error; `all[last_start..]` the last.
    first_end: int,
    last_start: int,
    // Where each error starts in `all`, and ends (exclusive).
    bounds: vec.Vec[int],
    // The tool's own rules (`toolbox.rules`, `extra_rules`), empty for most.
    extra: &static [byte],
}

pub fn empty[&h](heap: &!h Heap) -> [heap] Errors {
    return empty_in(heap, "");
}

// No errors yet, for a tool with rules of its own: `extra` is its `extra_rules`.
pub fn empty_in[&h](heap: &!h Heap, extra: &static [byte]) -> [heap] Errors {
    return Errors { all: buffer.empty(heap, 256), lines: buffer.empty(heap, 64), count: 0, first_exit: 0, first_end: 0, last_start: 0, bounds: vec.empty(heap, 8, 0), extra: extra };
}

pub fn drop[&h](heap: &!h Heap, e: Errors) -> [heap] int {
    let Errors { all, lines, count, first_exit, first_end, last_start, bounds, extra } = e;
    buffer.drop(heap, all);
    buffer.drop(heap, lines);
    vec.drop(heap, bounds);
    return count;
}

pub fn count[&e](e: &e Errors) -> [] int {
    return e.count;
}

pub fn exit_code[&e](e: &e Errors) -> [] int {
    return e.first_exit;
}

pub fn first[&e](e: &e Errors) -> [] &e [byte] {
    return buffer.bytes(e.all)[0..e.first_end];
}

pub fn last[&e](e: &e Errors) -> [] &e [byte] {
    let b = buffer.bytes(e.all);
    return b[e.last_start..len(b)];
}

// Error `k` (0-based), in the order added.
pub fn nth[&e](e: &e Errors, k: int) -> [] &e [byte] {
    let b = buffer.bytes(e.all);
    return b[vec.get(e.bounds, 2 * k)..vec.get(e.bounds, 2 * k + 1)];
}

// Every error, comma-separated, to go between `[` and `]`.
pub fn listed[&e](e: &e Errors) -> [] &e [byte] {
    return buffer.bytes(e.all);
}

pub fn sentences[&e](e: &e Errors) -> [] &e [byte] {
    return buffer.bytes(e.lines);
}

// Start an error: `{"code":…,"rule":…,"message":…,"hint":…`. An empty
// `hint` is written as `null`: there is a sentence or there is none.
pub fn open[&h, &m, &n](heap: &!h Heap, rule: &static [byte], message: &m [byte], hint: &n [byte]) -> [heap] json.Writer {
    return open_in(heap, "", rule, message, hint);
}

// `open` for a tool with rules of its own (`extra` is its `extra_rules`).
pub fn open_in[&h, &m, &n](heap: &!h Heap, extra: &static [byte], rule: &static [byte], message: &m [byte], hint: &n [byte]) -> [heap] json.Writer {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "code");
    w = json.put_string(heap, w, rules.code_name(rules.exit_of_in(extra, rule)));
    w = json.put_key(heap, w, "rule");
    w = json.put_string(heap, w, rule);
    w = json.put_key(heap, w, "message");
    w = json.put_string(heap, w, message);
    w = json.put_key(heap, w, "hint");
    if len(hint) == 0 {
        w = json.put_null(heap, w);
    } else {
        w = json.put_string(heap, w, hint);
    }
    return w;
}

// `"repair":null` -- nothing a script could apply without judgement.
pub fn no_repair[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    let k = json.put_key(heap, w, "repair");
    return json.put_null(heap, k);
}

// `"repair":{"kind":"none","reason":…}` -- the honest repair is
// information, not a command (D6 rule 2).
pub fn repair_none[&h, &r](heap: &!h Heap, w: json.Writer, reason: &r [byte]) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "repair");
    o = json.begin_object(heap, o);
    o = json.put_key(heap, o, "kind");
    o = json.put_string(heap, o, "none");
    o = json.put_key(heap, o, "reason");
    o = json.put_string(heap, o, reason);
    return json.end_object(heap, o);
}

// `"repair":{"kind":"retry","argv":[` -- the caller writes the argument
// strings, then `retry_close`.
pub fn retry_open[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "repair");
    o = json.begin_object(heap, o);
    o = json.put_key(heap, o, "kind");
    o = json.put_string(heap, o, "retry");
    o = json.put_key(heap, o, "argv");
    return json.begin_array(heap, o);
}

pub fn retry_close[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    let a = json.end_array(heap, w);
    return json.end_object(heap, a);
}

// The whole invocation as a retry, with argument `at` replaced by
// `replacement` -- the one shape of repair the tools build.
pub fn retry_replacing[&h, &g, &r](heap: &!h Heap, w: json.Writer, args: &g Args, at: int, replacement: &r [byte]) -> [heap, args] json.Writer {
    var o = retry_open(heap, w);
    var i = 0;
    while i < arg_count(args) {
        if i == at {
            o = json.put_string(heap, o, replacement);
        } else {
            o = json.put_string(heap, o, arg(args, i));
        }
        i = i + 1;
    }
    return retry_close(heap, o);
}

// `"repair":{"kind":"choose","options":[` -- the caller writes each option
// (`choose_option_open`, its arguments, `choose_option_close`), then
// `choose_close`. A script picks one; none is applied on its own.
pub fn choose_open[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "repair");
    o = json.begin_object(heap, o);
    o = json.put_key(heap, o, "kind");
    o = json.put_string(heap, o, "choose");
    o = json.put_key(heap, o, "options");
    return json.begin_array(heap, o);
}

// `{"argv":[` -- one option; the caller writes its argument strings
// (`choose_arg`), then `choose_option_close`.
pub fn choose_option_open[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    var o = json.begin_object(heap, w);
    o = json.put_key(heap, o, "argv");
    return json.begin_array(heap, o);
}

// One argument string of the option being written.
pub fn choose_arg[&h, &a](heap: &!h Heap, w: json.Writer, argument: &a [byte]) -> [heap] json.Writer {
    return json.put_string(heap, w, argument);
}

// `]}` -- the option is complete.
pub fn choose_option_close[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    let a = json.end_array(heap, w);
    return json.end_object(heap, a);
}

// `]}` -- the repair is complete.
pub fn choose_close[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    let a = json.end_array(heap, w);
    return json.end_object(heap, a);
}

// One whole option: the invocation with argument `at` replaced by
// `replacement` (as `retry_replacing` does for the one retry), between
// `choose_open` and `choose_close`.
pub fn choose_option_replacing[&h, &g, &r](heap: &!h Heap, w: json.Writer, args: &g Args, at: int, replacement: &r [byte]) -> [heap, args] json.Writer {
    var o = choose_option_open(heap, w);
    var i = 0;
    while i < arg_count(args) {
        if i == at {
            o = choose_arg(heap, o, replacement);
        } else {
            o = choose_arg(heap, o, arg(args, i));
        }
        i = i + 1;
    }
    return choose_option_close(heap, o);
}

// `"detail":{` -- rule-specific data; the caller writes keys, then `add`.
pub fn detail_open[&h](heap: &!h Heap, w: json.Writer) -> [heap] json.Writer {
    let k = json.put_key(heap, w, "detail");
    return json.begin_object(heap, k);
}

// `"key":"value"` in the detail: a string.
pub fn detail_str[&h, &k, &v](heap: &!h Heap, w: json.Writer, key: &k [byte], value: &v [byte]) -> [heap] json.Writer {
    let o = json.put_key(heap, w, key);
    return json.put_string(heap, o, value);
}

// `"key":N` in the detail: an integer.
pub fn detail_int[&h, &k](heap: &!h Heap, w: json.Writer, key: &k [byte], value: int) -> [heap] json.Writer {
    let o = json.put_key(heap, w, key);
    return json.put_int(heap, o, value);
}

// `"key":true|false` in the detail.
pub fn detail_bool[&h, &k](heap: &!h Heap, w: json.Writer, key: &k [byte], value: bool) -> [heap] json.Writer {
    let o = json.put_key(heap, w, key);
    return json.put_bool(heap, o, value);
}

// `"key":…` in the detail: bytes that may not be UTF-8, as `toolbox.text`
// writes them (a string, or `{"b64": …}`). Use this for a path or a key from
// the data; `detail_str` is for text the tool wrote itself.
pub fn detail_text[&h, &k, &v](heap: &!h Heap, w: json.Writer, key: &k [byte], value: &v [byte]) -> [heap] json.Writer {
    let o = json.put_key(heap, w, key);
    return text.put(heap, o, value);
}

// The rule of an error being built, read back from the writer: the second
// string in it. Kept so `add` needs no second copy of the tag.
fn rule_of[&w](doc: &w [byte]) -> [] &w [byte] {
    // `{"code":"…","rule":"…"` -- the rule starts after the fifth quote
    // following `"rule":`. Both strings are tags and code names, which
    // need no escape, so the first `"` after the opening one ends it.
    var quotes = 0;
    var at = 0;
    while at < len(doc) && quotes < 7 {
        if int_of(doc[at]) == '"' {
            quotes = quotes + 1;
        }
        at = at + 1;
    }
    var end = at;
    while end < len(doc) && int_of(doc[end]) != '"' {
        end = end + 1;
    }
    return doc[at..end];
}

// The message, read back the same way: the string after `"message":`.
// Messages are the tools' own literals, which hold no escapes.
fn message_of[&w](doc: &w [byte]) -> [] &w [byte] {
    var quotes = 0;
    var at = 0;
    while at < len(doc) && quotes < 11 {
        if int_of(doc[at]) == '"' {
            quotes = quotes + 1;
        }
        at = at + 1;
    }
    var end = at;
    while end < len(doc) && int_of(doc[end]) != '"' {
        end = end + 1;
    }
    return doc[at..end];
}

// Close the detail and the error, and keep it.
pub fn add[&h](heap: &!h Heap, e: Errors, w: json.Writer) -> [heap] Errors {
    let closed_detail = json.end_object(heap, w);
    let closed = json.end_object(heap, closed_detail);
    let one = json.finish(closed);
    let Errors { all, lines, count, first_exit, first_end, last_start, bounds, extra } = e;
    var a = all;
    var t = lines;
    var exit = first_exit;
    var fe = first_end;
    if count > 0 {
        a = buffer.push(heap, a, byte_of(','));
    }
    var start = 0;
    borrow a as &r in {
        start = buffer.size(r);
    }
    borrow one as &o in {
        let doc = buffer.bytes(o);
        a = buffer.append(heap, a, doc);
        let rule = rule_of(doc);
        t = buffer.append(heap, t, rule);
        t = buffer.append(heap, t, ": ");
        t = buffer.append(heap, t, message_of(doc));
        t = buffer.push(heap, t, byte_of(10));
        if count == 0 {
            exit = rules.exit_of_in(extra, rule);
        }
    }
    if count == 0 {
        borrow a as &r in {
            fe = buffer.size(r);
        }
    }
    buffer.drop(heap, one);
    var end = 0;
    borrow a as &r in {
        end = buffer.size(r);
    }
    var b = vec.push(heap, bounds, start);
    b = vec.push(heap, b, end);
    return Errors { all: a, lines: t, count: count + 1, first_exit: exit, first_end: fe, last_start: start, bounds: b, extra: extra };
}

// The common case: no repair, one string of detail.
pub fn simple[&h, &m, &n, &k, &v](heap: &!h Heap, e: Errors, rule: &static [byte], message: &m [byte], hint: &n [byte], key: &k [byte], value: &v [byte]) -> [heap] Errors {
    var w = open(heap, rule, message, hint);
    w = no_repair(heap, w);
    w = detail_open(heap, w);
    if len(key) > 0 {
        w = json.put_key(heap, w, key);
        w = json.put_string(heap, w, value);
    }
    return add(heap, e, w);
}

// An errno from opening or reading `shown`, as the rule it means
// (`io.*`). A directory is found at the first read, not at open
// (cancho `docs/agent-toolbox.md` A.5), which is why reading callers
// come here too. `ELOOP` (40 on Linux, 62 on macOS) is a link the tool
// would not follow (`toolbox.place`): a refusal of the tool's own, not a
// failure of the operating system's.
pub fn io_rule(errno: int, writing: bool) -> [] &static [byte] {
    if errno == 40 || errno == 62 {
        return "path.symlink";
    }
    if errno == 2 {
        return "io.not-found";
    }
    if errno == 20 {
        return "io.not-a-directory";
    }
    if errno == 21 {
        return "io.is-a-directory";
    }
    if errno == 13 || errno == 1 {
        return "io.permission-denied";
    }
    if writing {
        return "io.write-failed";
    }
    return "io.read-failed";
}

pub fn io_error[&h, &p](heap: &!h Heap, e: Errors, errno: int, writing: bool, shown: &p [byte]) -> [heap] Errors {
    let rule = io_rule(errno, writing);
    var message: &static [byte] = "the operating system failed the operation";
    var hint: &static [byte] = "";
    if errno == 2 {
        message = "no such file";
        hint = "check the path; it is relative to --root when one is given, otherwise to the working directory";
    } else if errno == 20 {
        message = "a component of the path is not a directory";
    } else if errno == 21 {
        message = "the path is a directory";
        hint = "name a file inside it";
    } else if errno == 13 || errno == 1 {
        message = "permission denied";
    } else if errno == 40 || errno == 62 {
        message = "the path runs through a symbolic link, and the tool does not follow links";
        hint = "name the file the link points to; under --root, it must be inside the root";
    }
    var w = open(heap, rule, message, hint);
    w = no_repair(heap, w);
    w = detail_open(heap, w);
    w = json.put_key(heap, w, "path");
    w = text.put(heap, w, shown);
    w = json.put_key(heap, w, "errno");
    w = json.put_int(heap, w, errno);
    return add(heap, e, w);
}
