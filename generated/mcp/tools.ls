\":false}]},\"total_lines\":{\"type\":\"null\"}},\"required\":[\"path\",\"size\",\"binary\",\"mode\",\"from\",\"to\",\"text\",\"eof\",\"truncated\",\"next\",\"total_lines\"],\"additionalProperties\":false}]}}}},{\"name\":\"jsonq\",\"description\":\"Look up one JSON Pointer (RFC 6901) in one strictly parsed JSON document; the value byte for byte, its kind, keys or length, and a parse error's position as data.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"pointer\":{\"type\":\"string\",\"description\":\"the JSON Pointer (RFC 6901) to look up, empty is the whole document\"},\"keys\":{\"type\":\"boolean\",\"description\":\"answer the keys of the object at the pointer, in document order\"},\"length\":{\"type\":\"boolean\",\"description\":\"answer the number of elements, pairs, or bytes of a string at the pointer\"},\"type\":{\"type\":\"boolean\",\"description\":\"answer only the kind of the value at the pointer\"},\"exists\":{\"type\":\"boolean\",\"description\":\"answer whether the pointer names anything, true or false, never an error\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the largest document accepted (ceiling 33554432), memory is about 25 times this\",\"default\":4194304},\"file\":{\"type\":\"string\",\"description\":\"the document, - or nothing reads standard input\"},\"stdin\":{\"type\":\"string\",\"description\":\"what the tool reads as standard input when no file is named\"}},\"required\":[],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://github.com/alpibrusl/lexsys-tools/schemas/jsonq.v1.json\",\"title\":\"jsonq.v1\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"jsonq\"},\"schema\":{\"const\":\"jsonq.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"error\":{\"$ref\":\"#/$defs/error\