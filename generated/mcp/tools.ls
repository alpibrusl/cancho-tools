h --if-sha256, only when the file is what the caller read); idempotent, locked, with --dry-run.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"old\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the exact bytes to find (not a pattern)\"},\"new\":{\"type\":\"string\",\"description\":\"the bytes to put in their place (may be empty)\"},\"expect\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"how many times --old must occur, any other count writes nothing\",\"default\":1},\"if-sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\",\"description\":\"the file's current content must also hash to this SHA-256\"},\"dry-run\":{\"type\":\"boolean\",\"description\":\"check everything and report planned_actions, exit 9, write nothing\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the largest file this will hold (ceiling 1073741824)\",\"default\":67108864},\"max-diff-lines\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the most changed lines the diff shows (ceiling 100000)\",\"default\":200},\"path\":{\"type\":\"string\",\"description\":\"the file to edit\"}},\"required\":[\"path\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://github.com/alpibrusl/lexsys-tools/schemas/replace.v1.json\",\"title\":\"replace.v1\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"replace\"},\"schema\":{\"const\":\"replace.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"replace\"},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"replacements\":{\"type\":\"integer\",\"minimum\":0},\"before_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"after_sha256\":{