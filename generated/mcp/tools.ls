},\"meta\":{\"type\":\"object\",\"properties\":{\"version\":{\"type\":\"string\"}},\"required\":[\"version\"],\"additionalProperties\":false},\"data\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"exists\":{\"type\":\"boolean\"}},\"required\":[\"pointer\",\"exists\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"kind\":{\"enum\":[\"null\",\"boolean\",\"integer\",\"float\",\"string\",\"array\",\"object\"]}},\"required\":[\"pointer\",\"kind\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"kind\":{\"enum\":[\"null\",\"boolean\",\"integer\",\"float\",\"string\",\"array\",\"object\"]},\"value\":{\"description\":\"the value as the document wrote it\"}},\"required\":[\"pointer\",\"kind\",\"value\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"kind\":{\"const\":\"object\"},\"keys\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"pointer\",\"kind\",\"keys\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"pointer\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"kind\":{\"enum\":[\"string\",\"array\",\"object\"]},\"length\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"pointer\",\"kind\",\"length\"],\"additionalProperties\":false}]}}}},{\"name\":\"tally\",\"description\":\"Count distinct lines or fields and report the most frequent, ordered by count then bytewise key; one bounded pass, the same answer on every machine.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"field\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"count field N (1-based) of each line instead of the whole line\"},\"delim\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the one byte that separates fields (default tab)\",\"default\":\"\\t\"},\"top\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"how many of the most frequent keys to report (ceiling 1000000)\",\"default\":10},\"max-keys\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the most distinct keys held, one more is limit.too-many-keys (ceiling 1000000)\",\"default\":100000},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the longest line counted, a longer one is limit.line-too-long (ceiling 16777216)\",\"default\":1048576},\"files\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"the files to count, in order, none reads standard input\"},\"stdin\":{\"type\":\"string\",\"description\":\"what the tool reads as standard input when no file is named\"}},\"required\":[],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://github.com/alpibrusl/lexsys-tools/schemas/tally.v1.json\",\"title\":\"tally.v1\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"tally\"},\"schema\":{\"const\":\"tally.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"$defs\":{\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]},\"repair\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"retry\"},\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1}},\"required\":[\"kind\",\"argv\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"none\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"kind\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"choose\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"argv\"],\"additionalProperties\":false}}},\"required\":[\"kind\",\"options\"],\"additionalProperties\":false}]},\"error\":{\"type\":\"object\",\"properties\":{\"code\":{\"enum\":[\"GENERAL_ERROR\",\"INVALID_ARGS\",\"NOT_FOUND\",\"PERMISSION_DENIED\",\"CONFLICT\",\"PRECONDITION_FAILED\"]},\"rule\":{\"type\":\"string\",\"pattern\":\"^[a-z]+\\\\.[a-z0-9-]+$\"},\"message\":{\"type\":\"string\"},\"hint\":{\"type\":[\"string\",\"null\"]},\"repair\":{\"$ref\":\"#/$defs/repair\"},\"detail\":{\"type\":\"object\"}},\"required\":[\"code\",\"rule\",\"message\",\"hint\",\"repair\",\"detail\"],\"additionalProperties\":false},\"meta\":{\"type\":\"object\",\"properties\":{\"version\":{\"type\":\"string\"}},\"required\":[\"version\"],\"additionalProperties\":false},\"data\":{\"type\":\"object\",\"properties\":{\"total\":{\"type\":\"integer\",\"minimum\":0},\"distinct\":{\"type\":\"integer\",\"minimum\":0},\"skipped\":{\"type\":\"integer\",\"minimum\":0},\"top\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"count\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"key\",\"count\"],\"additionalProperties\":false}},\"truncated\":{\"type\":\"boolean\"}},\"required\":[\"total\",\"distinct\",\"skipped\",\"top\",\"truncated\"],\"additionalProperties\":false}}}},{\"name\":\"hash\",\"description\":\"SHA-256 or SHA-512 of files of any size, as NDJSON records, with --verify; the hash write --if-sha256 wants, from a tool that cannot write.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"algo\":{\"enum\":[\"sha256\",\"sha512\"],\"description\":\"the digest\",\"default\":\"sha256\"},\"verify\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the expected digest in lowercase hex, takes one PATH, and a difference is precondition.hash-failed\"},\"paths\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"the files to hash, in order (one with --verify)\",\"minItems\":1}},\"required\":[\"paths\"],\"additionalProperties\":false}},{\"name\":\"move\",\"description\":\"Rename a file or directory in place, never over an existing name; locked, atomic, idempotent with --if-sha256, with --dry-run. One directory: a move to another is not offered.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"if-sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\",\"description\":\"the file's current content must hash to this SHA-256, and a retry that already landed then answers changed: false\"},\"dry-run\":{\"type\":\"boolean\",\"description\":\"check everything and report planned_actions, exit 9, change nothing\"},\"path\":{\"type\":\"string\",\"description\":\"the file or directory to rename\"},\"newname\":{\"type\":\"string\",\"description\":\"its new name: one component, in the same directory, and not one that exists\"}},\"required\":[\"path\",\"newname\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://github.com/alpibrusl/lexsys-tools/schemas/move.v1.json\",\"title\":\"move.v1\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"move\"},\"schema\":{\"const\":\"move.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"move\"},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"to\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"kind\":{\"enum\":[\"file\",\"directory\",\"link\",\"other\"]},\"sha256\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}]}},\"required\":[\"op\",\"path\",\"to\",\"kind\",\"sha256\"],\"additionalProperties\":false}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"$defs\":{\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]},\"repair\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"retry\"},\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1}},\"required\":[\"kind\",\"argv\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"none\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"kind\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"choose\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"argv\"],\"additionalProperties\":false}}},\"required\":[\"kind\",\"options\"],\"additionalProperties\":false}]},\"error\":{\"type\":\"object\",\"properties\":{\"code\":{\"enum\":[\"GENERAL_ERROR\",\"INVALID_ARGS\",\"NOT_FOUND\",\"PERMISSION_DENIED\",\"CONFLICT\",\"PRECONDITION_FAILED\"]},\"rule\":{\"type\":\"string\",\"pattern\":\"^[a-z]+\\\\.[a-z0-9-]+$\"},\"message\":{\"type\":\"string\"},\"hint\":{\"type\":[\"string\",\"null\"]},\"repair\":{\"$ref\":\"#/$defs/repair\"},\"detail\":{\"type\":\"object\"}},\"required\":[\"code\",\"rule\",\"message\",\"hint\",\"repair\",\"detail\"],\"additionalProperties\":false},\"meta\":{\"type\":\"object\",\"properties\":{\"version\":{\"type\":\"string\"}},\"required\":[\"version\"],\"additionalProperties\":false},\"data\":{\"type\":\"object\",\"properties\":{\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"to\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"changed\":{\"type\":\"boolean\"},\"kind\":{\"enum\":[\"file\",\"directory\",\"link\",\"other\"]},\"sha256\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}]}},\"required\":[\"path\",\"to\",\"changed\",\"kind\",\"sha256\"],\"additionalProperties\":false}}}},{\"name\":\"list\",\"description\":\"The entries beneath a directory, sorted bytewise, depth-bounded and capped, as NDJSON records; links listed and never followed, and no verb but reading.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"depth\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"how many levels to descend: 1 is the directory's own entries (ceiling 64)\",\"default\":1},\"max-entries\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"stop after this many entries in total, and report truncated with a next cursor (ceiling 1000000)\",\"default\":10000},\"skip\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"skip this many entries before reporting any (the next cursor of a truncated run)\",\"default\":0},\"long\":{\"type\":\"boolean\",\"description\":\"add each entry's size in bytes and modification time in seconds\"},\"dirs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"the directories to list, in order (none: the root, or else the working directory)\"}},\"required\":[],\"additionalProperties\":false}}]}";
}

pub fn count() -> [] int {
    return 9;
}

pub fn name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "seek";
    }
    if i == 1 {
        return "write";
    }
    if i == 2 {
        return "replace";
    }
    if i == 3 {
        return "peek";
    }
    if i == 4 {
        return "jsonq";
    }
    if i == 5 {
        return "tally";
    }
    if i == 6 {
        return "hash";
    }
    if i == 7 {
        return "move";
    }
    if i == 8 {
        return "list";
    }
    return "";
}

pub fn flags(i: int) -> [] &static [byte] {
    if i == 0 {
        return "max-count|--max-count|nat;skip|--skip|nat;max-line-bytes|--max-line-bytes|nat;ascii-case-insensitive|--ascii-case-insensitive|bool;require-match|--require-match|bool";
    }
    if i == 1 {
        return "create|--create|bool;if-sha256|--if-sha256|text;content-sha256|--content-sha256|text;dry-run|--dry-run|bool;content-file|--content-file|text;max-bytes|--max-bytes|nat;max-diff-lines|--max-diff-lines|nat";
    }
    if i == 2 {
        return "old|--old|text;new|--new|text;expect|--expect|nat;if-sha256|--if-sha256|text;dry-run|--dry-run|bool;max-bytes|--max-bytes|nat;max-diff-lines|--max-diff-lines|nat";
    }
    if i == 3 {
        return "lines|--lines|text;bytes|--bytes|text;max-bytes|--max-bytes|nat;max-line-bytes|--max-line-bytes|nat;count-lines|--count-lines|bool";
    }
    if i == 4 {
        return "pointer|--pointer|text;keys|--keys|bool;length|--length|bool;type|--type|bool;exists|--exists|bool;max-bytes|--max-bytes|nat";
    }
    if i == 5 {
        return "field|--field|nat;delim|--delim|text;top|--top|nat;max-keys|--max-keys|nat;max-line-bytes|--max-line-bytes|nat";
    }
    if i == 6 {
        return "algo|--algo|text;verify|--verify|text";
    }
    if i == 7 {
        return "if-sha256|--if-sha256|text;dry-run|--dry-run|bool";
    }
    if i == 8 {
        return "depth|--depth|nat;max-entries|--max-entries|nat;skip|--skip|nat;long|--long|bool";
    }
    return "";
}

pub fn operands(i: int) -> [] &static [byte] {
    if i == 0 {
        return "pattern|1|1;files|1|";
    }
    if i == 1 {
        return "path|1|1";
    }
    if i == 2 {
        return "path|1|1";
    }
    if i == 3 {
        return "path|1|1";
    }
    if i == 4 {
        return "file|0|1";
    }
    if i == 5 {
        return "files|0|";
    }
    if i == 6 {
        return "paths|1|";
    }
    if i == 7 {
        return "path|1|1;newname|1|1";
    }
    if i == 8 {
        return "dirs|0|";
    }
    return "";
}

pub fn stdin(i: int) -> [] &static [byte] {
    if i == 0 {
        return "";
    }
    if i == 1 {
        return "flag";
    }
    if i == 2 {
        return "";
    }
    if i == 3 {
        return "";
    }
    if i == 4 {
        return "implicit";
    }
    if i == 5 {
        return "implicit";
    }
    if i == 6 {
        return "";
    }
    if i == 7 {
        return "";
    }
    if i == 8 {
        return "";
    }
    return "";
}

pub fn output(i: int) -> [] &static [byte] {
    if i == 0 {
        return "stream";
    }
    if i == 1 {
        return "document";
    }
    if i == 2 {
        return "document";
    }
    if i == 3 {
        return "document";
    }
    if i == 4 {
        return "document";
    }
    if i == 5 {
        return "document";
    }
    if i == 6 {
        return "stream";
    }
    if i == 7 {
        return "document";
    }
    if i == 8 {
        return "stream";
    }
    return "";
}

// The binary for tool `i`, beneath the directory the server's `Exec` is
// narrowed to.
pub fn path(i: int) -> [] &static [byte] {
    if i == 0 {
        return "/opt/lexsys-tools/bin/seek";
    }
    if i == 1 {
        return "/opt/lexsys-tools/bin/write";
    }
    if i == 2 {
        return "/opt/lexsys-tools/bin/replace";
    }
    if i == 3 {
        return "/opt/lexsys-tools/bin/peek";
    }
    if i == 4 {
        return "/opt/lexsys-tools/bin/jsonq";
    }
    if i == 5 {
        return "/opt/lexsys-tools/bin/tally";
    }
    if i == 6 {
        return "/opt/lexsys-tools/bin/hash";
    }
    if i == 7 {
        return "/opt/lexsys-tools/bin/move";
    }
    if i == 8 {
        return "/opt/lexsys-tools/bin/list";
    }
    return "";
}
