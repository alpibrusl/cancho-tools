pub fn list_result() -> [] &static [byte] {
    return "{\"tools\":[{\"name\":\"seek\",\"description\":\"Search files for a literal string; NDJSON records with tagged errors, bounded memory, and an authority with no write, network or foreign code.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"max-count\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"stop after this many matches in total, and report truncated with a next cursor\"},\"skip\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"skip this many matches before reporting any (the next cursor of a truncated run)\",\"default\":0},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the longest line held, a longer one is limit.line-too-long (ceiling 16777216)\",\"default\":1048576},\"ascii-case-insensitive\":{\"type\":\"boolean\",\"description\":\"fold ASCII letters only when comparing\"},\"require-match\":{\"type\":\"boolean\",\"description\":\"exit 8 (precondition.no-match) when nothing matched\"},\"pattern\":{\"type\":\"string\",\"description\":\"the literal bytes to find, not a regular expression\"},\"files\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"the files to search, in order\",\"minItems\":1}},\"required\":[\"pattern\",\"files\"],\"additionalProperties\":false}},{\"name\":\"write\",\"description\":\"Replace a file atomically, only if it holds what the caller says it holds (--if-sha256) or does not exist (--create); idempotent, locked, with --dry-run.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"create\":{\"type\":\"boolean\",\"description\":\"the path must not exist yet (if it holds exactly the new content, nothing is written and changed is false)\"},\"if-sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\",\"description\":\"the file's current content must hash to this SHA-256\"},\"content-sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\",\"description\":\"the new content must hash to this SHA-256, checked before anything is written\"},\"dry-run\":{\"type\":\"boolean\",\"description\":\"check everything and report planned_actions, exit 9, write nothing\"},\"content-file\":{\"type\":\"string\",\"description\":\"read the new content from this file\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the largest new content accepted, and the largest old content diffed (ceiling 1073741824)\",\"default\":67108864},\"max-diff-lines\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"the most changed lines the diff shows (ceiling 100000)\",\"default\":200},\"path\":{\"type\":\"string\",\"description\":\"the file to create or replace\"},\"stdin\":{\"type\":\"string\",\"description\":\"what the tool reads as standard input (sent with --stdin)\"}},\"required\":[\"path\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://github.com/alpibrusl/lexsys-tools/schemas/write.v1.json\",\"title\":\"write.v1\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"write\"},\"schema\":{\"const\":\"write.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"before_sha256\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}]},\"after_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"diff\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"old_start\":{\"type\":\"integer\",\"minimum\":1},\"new_start\":{\"type\":\"integer\",\"minimum\":1},\"removed_count\":{\"type\":\"integer\",\"minimum\":0},\"added_count\":{\"type\":\"integer\",\"minimum\":0},