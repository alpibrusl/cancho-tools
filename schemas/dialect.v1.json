{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alpibrusl/cancho-tools/schemas/dialect.v1.json",
  "title": "dialect.v1",
  "description": "One JSON object on one line. ok is false exactly when errors is present; error is its first element.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "dialect"
    },
    "schema": {
      "const": "dialect.v1"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      },
      "minItems": 1
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "required": [
    "ok",
    "command",
    "schema",
    "meta"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "errors"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "error",
          "errors"
        ]
      }
    }
  ],
  "$defs": {
    "text_or_bytes": {
      "description": "UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "required": [
            "b64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "repair": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "retry"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "argv"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "choose"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "argv"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "options"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "GENERAL_ERROR",
            "INVALID_ARGS",
            "NOT_FOUND",
            "PERMISSION_DENIED",
            "CONFLICT",
            "PRECONDITION_FAILED"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9-]+$"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "repair": {
          "$ref": "#/$defs/repair"
        },
        "detail": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "rule",
        "message",
        "hint",
        "repair",
        "detail"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "delimiter": {
              "$ref": "#/$defs/text_or_bytes"
            },
            "delimiter_name": {
              "enum": [
                "comma",
                "semicolon",
                "tab",
                "pipe",
                "other"
              ]
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                "none"
              ]
            },
            "also_fits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fields": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "ragged_rows": {
              "type": "integer",
              "minimum": 0
            },
            "blank_lines": {
              "type": "integer",
              "minimum": 0
            },
            "line_ending": {
              "enum": [
                "lf",
                "crlf"
              ]
            },
            "byte_order_mark": {
              "type": "boolean"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text_or_bytes"
                  },
                  "kind": {
                    "enum": [
                      "empty",
                      "integer",
                      "number",
                      "date",
                      "text"
                    ]
                  },
                  "decimal": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "dot",
                          "comma",
                          "mixed"
                        ]
                      }
                    ]
                  },
                  "missing": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_marker": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/text_or_bytes"
                      }
                    ]
                  },
                  "values": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/text_or_bytes"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "kind",
                  "decimal",
                  "missing",
                  "missing_marker",
                  "values"
                ],
                "additionalProperties": false
              }
            },
            "text_missing_markers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "$ref": "#/$defs/text_or_bytes"
                  },
                  "marker": {
                    "$ref": "#/$defs/text_or_bytes"
                  },
                  "cells": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "column",
                  "marker",
                  "cells"
                ],
                "additionalProperties": false
              }
            },
            "label_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "$ref": "#/$defs/text_or_bytes"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text_or_bytes"
                    }
                  },
                  "map": {
                    "$ref": "#/$defs/text_or_bytes"
                  }
                },
                "required": [
                  "column",
                  "values",
                  "map"
                ],
                "additionalProperties": false
              }
            },
            "normalize": {
              "$ref": "#/$defs/text_or_bytes"
            }
          },
          "required": [
            "delimiter",
            "delimiter_name",
            "confidence",
            "also_fits",
            "fields",
            "rows",
            "ragged_rows",
            "blank_lines",
            "line_ending",
            "byte_order_mark",
            "columns",
            "text_missing_markers",
            "label_candidates",
            "normalize"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "delimiter_read": {
              "enum": [
                "comma",
                "semicolon",
                "tab",
                "pipe",
                "other"
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "decimals_converted": {
              "type": "integer",
              "minimum": 0
            },
            "cells_blanked": {
              "type": "integer",
              "minimum": 0
            },
            "cells_recoded": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "$ref": "#/$defs/text_or_bytes"
            }
          },
          "required": [
            "delimiter_read",
            "columns",
            "rows",
            "decimals_converted",
            "cells_blanked",
            "cells_recoded",
            "bytes",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
