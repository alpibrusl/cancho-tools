edition 7;

import std.buffer;
import std.bytes;
import std.test;
import archive.tar;

// A tar of: `a.txt` ("hello"), the directory `d/`, and `d/b.txt` ("world!").
fn sample[&h](heap: &!h Heap) -> [heap] buffer.Buffer {
    var t = buffer.empty(heap, 4096);
    let (t1, w1) = tar.header(heap, t, "a.txt", 5, false, 420);
    t = tar.body_of(heap, t1, "hello");
    let (t2, w2) = tar.header(heap, t, "d", 0, true, 493);
    let (t3, w3) = tar.header(heap, t2, "d/b.txt", 6, false, 493);
    t = tar.body_of(heap, t3, "world!");
    return tar.finish(heap, t);
}

fn count_of[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] int {
    let e = tar.parse(heap, data, 1000);
    var n = 0;
    borrow e as &r in {
        n = tar.count(r);
    }
    tar.drop(heap, e);
    return n;
}

fn failure_of[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] int {
    let e = tar.parse(heap, data, 1000);
    var f = 0;
    borrow e as &r in {
        f = tar.failure(r);
    }
    tar.drop(heap, e);
    return f;
}

pub fn test_what_the_writer_writes_the_reader_reads[&h](heap: &!h Heap) -> [heap] int {
    let t = sample(heap);
    borrow t as &d in {
        test.assert_eq(buffer.size(d) % 512, 0);
        let e = tar.parse(heap, buffer.bytes(d), 100);
        borrow e as &r in {
            test.assert_eq(tar.failure(r), 0);
            test.assert_eq(tar.count(r), 3);
            test.assert(bytes.equal(tar.name(r, 0), "a.txt"));
            test.assert(bytes.equal(tar.name(r, 1), "d"));
            test.assert(bytes.equal(tar.name(r, 2), "d/b.txt"));
            test.assert_eq(tar.kind(r, 0), 1);
            test.assert_eq(tar.kind(r, 1), 2);
            test.assert_eq(tar.size(r, 0), 5);
            test.assert_eq(tar.size(r, 1), 0);
            test.assert_eq(tar.size(r, 2), 6);
            test.assert_eq(tar.mode(r, 0), 420);
            test.assert_eq(tar.mode(r, 2), 493);
            let at = tar.body(r, 2);
            test.assert(bytes.equal(buffer.bytes(d)[at..at + 6], "world!"));
            test.assert(!tar.unsafe_at(r, 0));
        }
        tar.drop(heap, e);
        test.assert(tar.looks_like_tar(buffer.bytes(d)));
    }
    buffer.drop(heap, t);
    return 0;
}

pub fn test_the_bytes_are_a_function_of_the_arguments[&h](heap: &!h Heap) -> [heap] int {
    let a = sample(heap);
    let b = sample(heap);
    borrow a as &x in {
        borrow b as &y in {
            test.assert(bytes.equal(buffer.bytes(x), buffer.bytes(y)));
            // Owner 0, mtime 0, the ustar magic, and the checksum field "NNNNNN\0 ".
            test.assert(bytes.equal(buffer.bytes(x)[257..262], "ustar"));
            test.assert_eq(int_of(buffer.bytes(x)[155]), ' ');
            test.assert_eq(int_of(buffer.bytes(x)[154]), 0);
        }
    }
    buffer.drop(heap, a);
    buffer.drop(heap, b);
    return 0;
}

pub fn test_a_long_name_is_split_into_prefix_and_name[&h](heap: &!h Heap) -> [heap] int {
    // 60 + 1 + 60 + 1 + 40 = 162 bytes: too long for the name field, fine with a prefix.
    let long = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccccccccccccccccccccccccccccccccc";
    test.assert_eq(len(long), 162);
    test.assert(tar.split_point(long) > 0);
    var t = buffer.empty(heap, 2048);
    let (t1, why) = tar.header(heap, t, long, 0, false, 420);
    test.assert_eq(why, 0);
    t = tar.finish(heap, t1);
    borrow t as &d in {
        let e = tar.parse(heap, buffer.bytes(d), 100);
        borrow e as &r in {
            test.assert_eq(tar.count(r), 1);
            test.assert(bytes.equal(tar.name(r, 0), long));
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, t);
    // One component of 101 bytes cannot be split anywhere.
    var one = buffer.empty(heap, 128);
    var i = 0;
    while i < 101 {
        one = buffer.push(heap, one, byte_of('x'));
        i = i + 1;
    }
    borrow one as &o in {
        test.assert_eq(tar.split_point(buffer.bytes(o)), 0 - 2);
        let (u, no) = tar.header(heap, buffer.empty(heap, 1), buffer.bytes(o), 0, false, 420);
        test.assert_eq(no, 1);
        buffer.drop(heap, u);
    }
    buffer.drop(heap, one);
    return 0;
}

pub fn test_names_are_normalised_and_the_unsafe_are_flagged[&h](heap: &!h Heap) -> [heap] int {
    test.assert(tar.unsafe_name("/etc/passwd"));
    test.assert(tar.unsafe_name("../x"));
    test.assert(tar.unsafe_name("a/../../x"));
    test.assert(tar.unsafe_name("a/.."));
    test.assert(!tar.unsafe_name("a/..b"));
    test.assert(!tar.unsafe_name("..a/b"));
    test.assert(!tar.unsafe_name("./a//b/"));
    test.assert(!tar.unsafe_name("a.b/c..d"));
    let n1 = tar.normalised(heap, "./a//b/./c/");
    borrow n1 as &a in {
        test.assert(bytes.equal(buffer.bytes(a), "a/b/c"));
    }
    buffer.drop(heap, n1);
    let n2 = tar.normalised(heap, "./");
    borrow n2 as &b in {
        test.assert(bytes.equal(buffer.bytes(b), "."));
    }
    buffer.drop(heap, n2);
    // A hostile name is carried through the writer and flagged by the reader.
    var t = buffer.empty(heap, 2048);
    let (t1, why) = tar.header(heap, t, "../escape", 1, false, 420);
    t = tar.body_of(heap, t1, "x");
    t = tar.finish(heap, t);
    borrow t as &d in {
        let e = tar.parse(heap, buffer.bytes(d), 100);
        borrow e as &r in {
            test.assert_eq(tar.count(r), 1);
            test.assert(tar.unsafe_at(r, 0));
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, t);
    return 0;
}

pub fn test_damage_is_a_failure_never_a_trap[&h](heap: &!h Heap) -> [heap] int {
    let t = sample(heap);
    borrow t as &d in {
        let all = buffer.bytes(d);
        test.assert_eq(failure_of(heap, all), 0);
        // Cut at every offset (stepping by 37): never a trap, and a cut that loses the end marker is a failure.
        var cut = 0;
        while cut < len(all) {
            let f = failure_of(heap, all[0..cut]);
            test.assert(f == 0 || f == 1 || f == 2 || f == 3);
            if cut < len(all) - 1024 {
                test.assert(f != 0);
            }
            cut = cut + 37;
        }
        // A byte of the first header changed: its checksum no longer matches.
        var copy = buffer.empty(heap, len(all));
        copy = buffer.append(heap, copy, all);
        let loose = box_slice(heap, len(all), byte_of(0));
        borrow mut loose as &!w in {
            var i = 0;
            while i < len(all) {
                contents(w)[i] = all[i];
                i = i + 1;
            }
            contents(w)[3] = byte_of(int_of(all[3]) ^ 1);
        }
        borrow loose as &l in {
            test.assert_eq(failure_of(heap, contents(l)), 2);
        }
        unbox_slice(heap, loose);
        buffer.drop(heap, copy);
        // Every single-byte change of the whole archive is a status.
        let flip = box_slice(heap, len(all), byte_of(0));
        var at = 0;
        while at < len(all) {
            borrow mut flip as &!w in {
                var i = 0;
                while i < len(all) {
                    contents(w)[i] = all[i];
                    i = i + 1;
                }
                contents(w)[at] = byte_of(int_of(all[at]) ^ 0x5a);
            }
            borrow flip as &f in {
                let status = failure_of(heap, contents(f));
                test.assert(status >= 0 && status <= 4);
            }
            at = at + 13;
        }
        unbox_slice(heap, flip);
    }
    buffer.drop(heap, t);
    return 0;
}

pub fn test_the_entry_limit_is_a_failure[&h](heap: &!h Heap) -> [heap] int {
    let t = sample(heap);
    borrow t as &d in {
        let e = tar.parse(heap, buffer.bytes(d), 2);
        borrow e as &r in {
            test.assert_eq(tar.failure(r), 4);
            test.assert_eq(tar.count(r), 2);
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, t);
    return 0;
}

pub fn test_a_size_that_cannot_fit_is_truncated_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    // A header that claims 2^40 bytes of body.
    var t = buffer.empty(heap, 1024);
    let (t1, why) = tar.header(heap, t, "big", 5, false, 420);
    t = t1;
    borrow t as &d in {
        let loose = box_slice(heap, 512, byte_of(0));
        borrow mut loose as &!w in {
            var i = 0;
            while i < 512 {
                contents(w)[i] = buffer.bytes(d)[i];
                i = i + 1;
            }
            // size "17777777777" (octal, 11 digits = 2^33 - 1), then the checksum fixed up.
            var k = 0;
            while k < 11 {
                contents(w)[124 + k] = byte_of('7');
                k = k + 1;
            }
            contents(w)[135] = byte_of(0);
            var sum = 0;
            i = 0;
            while i < 512 {
                if i >= 148 && i < 156 {
                    sum = sum + 32;
                } else {
                    sum = sum + int_of(contents(w)[i]);
                }
                i = i + 1;
            }
            var shift = 15;
            var j = 0;
            while j < 6 {
                contents(w)[148 + j] = byte_of('0' + (sum >> shift & 7));
                shift = shift - 3;
                j = j + 1;
            }
        }
        borrow loose as &l in {
            test.assert_eq(failure_of(heap, contents(l)), 1);
        }
        unbox_slice(heap, loose);
    }
    buffer.drop(heap, t);
    return 0;
}

// A GNU long-name header whose body is read to a NUL: with a size it claims past the data and a body
// that has no NUL to the end, a reader that trusts the claim reads off the end.
pub fn test_a_long_name_that_claims_more_than_the_data_is_truncated_not_a_trap[&h](heap: &!h Heap) -> [heap] int {
    var claim = 600;
    while claim <= 1300 {
        var t = buffer.empty(heap, 2048);
        let (t1, why) = tar.header(heap, t, "header", 5, false, 420);
        t = t1;
        let loose = box_slice(heap, 1212, byte_of('A'));
        borrow t as &d in {
            borrow mut loose as &!w in {
                var i = 0;
                while i < 512 {
                    contents(w)[i] = buffer.bytes(d)[i];
                    i = i + 1;
                }
                contents(w)[156] = byte_of('L');
                // size: eleven octal digits of `claim`
                var digits = 0;
                var rest = claim;
                var at = 134;
                while digits < 11 {
                    contents(w)[at] = byte_of('0' + rest % 8);
                    rest = rest / 8;
                    at = at - 1;
                    digits = digits + 1;
                }
                var sum = 0;
                i = 0;
                while i < 512 {
                    if i >= 148 && i < 156 {
                        sum = sum + 32;
                    } else {
                        sum = sum + int_of(contents(w)[i]);
                    }
                    i = i + 1;
                }
                var shift = 15;
                var j = 0;
                while j < 6 {
                    contents(w)[148 + j] = byte_of('0' + (sum >> shift & 7));
                    shift = shift - 3;
                    j = j + 1;
                }
            }
            borrow loose as &l in {
                test.assert_eq(failure_of(heap, contents(l)), 1);
            }
        }
        unbox_slice(heap, loose);
        buffer.drop(heap, t);
        claim = claim + 71;
    }
    return 0;
}

// ---- the incremental reader against `parse` -------------------------------------------------------------------

// A number that stands for everything `parse` and `scan_feed` say about an entry: its name, kind, size, mode and flag.
fn fold[&e](entries: &e tar.Entries, from: int) -> [] int {
    var h = from;
    var k = 0;
    while k < tar.count(entries) {
        let name = tar.name(entries, k);
        var j = 0;
        while j < len(name) {
            h = h * 31 + int_of(name[j]) & 0xffffffffff;
            j = j + 1;
        }
        h = h * 31 + tar.kind(entries, k) & 0xffffffffff;
        h = h * 31 + tar.size(entries, k) & 0xffffffffff;
        h = h * 31 + tar.mode(entries, k) & 0xffffffffff;
        if tar.unsafe_at(entries, k) {
            h = h * 31 + 7 & 0xffffffffff;
        }
        h = h * 31 + 1 & 0xffffffffff;
        k = k + 1;
    }
    return h;
}

// What `parse` says of `data`: the fingerprint of its entries, how many, the failure, where.
fn by_parse[&h, &d](heap: &!h Heap, data: &d [byte], most: int) -> [heap] (int, int, int, int) {
    let e = tar.parse(heap, data, most);
    var a = 0;
    var b = 0;
    var c = 0;
    var d2 = 0;
    borrow e as &r in {
        a = fold(r, 1);
        b = tar.count(r);
        c = tar.failure(r);
        d2 = tar.failure_at(r);
    }
    tar.drop(heap, e);
    return (a, b, c, d2);
}

// The same by `scan_feed`, `chunk` bytes at a time.
fn by_scan[&h, &d](heap: &!h Heap, data: &d [byte], chunk: int, most: int) -> [heap] (int, int, int, int) {
    var sc = tar.scan_open(heap, most);
    var a = 1;
    var b = 0;
    var at = 0;
    while at < len(data) {
        var n = chunk;
        if n > len(data) - at {
            n = len(data) - at;
        }
        let (next, found) = tar.scan_feed(heap, sc, data[at..at + n], tar.entries_empty(heap));
        sc = next;
        borrow found as &fr in {
            a = fold(fr, a);
            b = b + tar.count(fr);
        }
        tar.drop(heap, found);
        at = at + n;
    }
    var failure = 0;
    var failure_at = 0;
    borrow mut sc as &!m in {
        failure = tar.scan_finish(m);
    }
    borrow sc as &r in {
        failure_at = tar.scan_failure_at(r);
    }
    tar.scan_drop(heap, sc);
    return (a, b, failure, failure_at);
}

fn agree[&h, &d](heap: &!h Heap, data: &d [byte], chunk: int, most: int) -> [heap] bool {
    let (a1, b1, c1, d1) = by_parse(heap, data, most);
    let (a2, b2, c2, d2) = by_scan(heap, data, chunk, most);
    if c1 != 0 {
        // `parse` keeps the entries before a failure; so does the scanner.
        return a1 == a2 && b1 == b2 && c1 == c2 && d1 == d2;
    }
    return a1 == a2 && b1 == b2 && c2 == 0;
}

// `data` with the byte at `at` replaced.
fn with_byte[&h, &d](heap: &!h Heap, data: &d [byte], at: int, value: int) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(data));
    var i = 0;
    while i < len(data) {
        if i == at {
            out = buffer.push(heap, out, byte_of(value));
        } else {
            out = buffer.push(heap, out, data[i]);
        }
        i = i + 1;
    }
    return out;
}

// A header with the type flag `flag` and a body of `body`, padded: a pax or long-name header, or one of the others.
fn special[&h, &b](heap: &!h Heap, out: buffer.Buffer, flag: int, body: &b [byte]) -> [heap] buffer.Buffer {
    let (header, why) = tar.header(heap, out, "special", len(body), false, 420);
    let buffer.Buffer { held, used } = header;
    var box = held;
    borrow mut box as &!w in {
        let s = contents(w);
        let at = used - 512;
        s[at + 156] = byte_of(flag);
        // The checksum: the sum of the bytes with the field as spaces, six octal digits, a NUL and a space.
        var sum = 0;
        var i = 0;
        while i < 512 {
            if i >= 148 && i < 156 {
                sum = sum + 32;
            } else {
                sum = sum + int_of(s[at + i]);
            }
            i = i + 1;
        }
        var k = 5;
        var v = sum;
        while k >= 0 {
            s[at + 148 + k] = byte_of('0' + v % 8);
            v = v / 8;
            k = k - 1;
        }
        s[at + 154] = byte_of(0);
        s[at + 155] = byte_of(' ');
    }
    return tar.body_of(heap, buffer.Buffer { held: box, used: used }, body);
}

// Archives that use what the incremental reader has to keep apart: long names, pax paths and sizes, global headers.
fn rich[&h](heap: &!h Heap, which: int) -> [heap] buffer.Buffer {
    if which == 0 {
        return sample(heap);
    }
    var t = buffer.empty(heap, 8192);
    if which == 1 {
        // A GNU long name (a NUL-ended name in the body of an `L` header), then the entry it names.
        t = special(heap, t, 'L', "a/very/long/name/that/the/header/field/could/hold/in/the/body/instead.txt\0");
        let (t1, w1) = tar.header(heap, t, "short", 3, false, 420);
        t = tar.body_of(heap, t1, "abc");
        let (t2, w2) = tar.header(heap, t, "after", 0, false, 420);
        return tar.finish(heap, t2);
    }
    if which == 2 {
        // A pax path and a pax size (the header says 0, the pax record says 7), then a plain entry.
        t = special(heap, t, 'x', "25 path=px/long/file.txt\n10 size=7\n");
        let (t1, w1) = tar.header(heap, t, "ignored", 0, false, 420);
        t = tar.body_of(heap, t1, "1234567");
        let (t2, w2) = tar.header(heap, t, "plain", 2, false, 420);
        t = tar.body_of(heap, t2, "hi");
        return tar.finish(heap, t);
    }
    if which == 3 {
        // A global header and a link header are skipped; unsafe and odd names are flagged and normalised; a directory.
        t = special(heap, t, 'g', "23 comment=hello there\n");
        t = special(heap, t, 'K', "ignored link target");
        let (t1, w1) = tar.header(heap, t, "../escape", 1, false, 420);
        t = tar.body_of(heap, t1, "x");
        let (t2, w2) = tar.header(heap, t, "./a//b/./c", 0, false, 420);
        let (t3, w3) = tar.header(heap, t2, "dir", 0, true, 493);
        let (t4, w4) = tar.header(heap, t3, "/abs", 0, false, 420);
        return tar.finish(heap, t4);
    }
    if which == 4 {
        // Only the end marker.
        return tar.finish(heap, t);
    }
    // A 700-byte body, a size that is a whole block, and an empty file.
    let (t1, w1) = tar.header(heap, t, "big", 700, false, 420);
    let body = noise(heap, 700, 256, 3);
    borrow body as &br in {
        t = tar.body_of(heap, t1, buffer.bytes(br));
    }
    buffer.drop(heap, body);
    let (t2, w2) = tar.header(heap, t, "block", 512, false, 420);
    let body2 = noise(heap, 512, 256, 4);
    borrow body2 as &br2 in {
        t = tar.body_of(heap, t2, buffer.bytes(br2));
    }
    buffer.drop(heap, body2);
    let (t3, w3) = tar.header(heap, t, "empty", 0, false, 420);
    return tar.finish(heap, t3);
}

fn noise[&h](heap: &!h Heap, n: int, spread: int, seed: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, n);
    var x = seed;
    var i = 0;
    while i < n {
        x = x * 1103515245 + 12345 & 0x7fffffff;
        b = buffer.push(heap, b, byte_of((x >> 8) % spread));
        i = i + 1;
    }
    return b;
}

pub fn test_the_scanner_makes_the_entries_parse_makes[&h](heap: &!h Heap) -> [heap] int {
    var which = 0;
    while which < 6 {
        let t = rich(heap, which);
        borrow t as &d in {
            let data = buffer.bytes(d);
            // The whole archive, and with a failure from every kind of cut.
            var chunk = 1;
            while chunk < 100000 {
                test.assert(agree(heap, data, chunk, 1000));
                test.assert(agree(heap, data, chunk, 1));
                test.assert(agree(heap, data, chunk, 2));
                chunk = chunk * 3 + 1;
            }
            var cut = 0;
            while cut < len(data) {
                test.assert(agree(heap, data[0..cut], 97, 1000));
                test.assert(agree(heap, data[0..cut], 512, 1000));
                cut = cut + 41;
            }
        }
        buffer.drop(heap, t);
        which = which + 1;
    }
    return 0;
}

pub fn test_the_scanner_agrees_with_parse_on_damage[&h](heap: &!h Heap) -> [heap] int {
    var which = 0;
    while which < 4 {
        let t = rich(heap, which);
        borrow t as &d in {
            let data = buffer.bytes(d);
            var at = 0;
            while at < len(data) {
                // A byte in a header or its first bytes of body is damaged: both readers see the same archive.
                if at % 512 < 400 || at % 512 > 500 {
                    let bad = with_byte(heap, data, at, 0xff ^ int_of(data[at]));
                    borrow bad as &br in {
                        test.assert(agree(heap, buffer.bytes(br), 100000, 1000));
                        test.assert(agree(heap, buffer.bytes(br), 61, 1000));
                    }
                    buffer.drop(heap, bad);
                }
                at = at + 7;
            }
        }
        buffer.drop(heap, t);
        which = which + 1;
    }
    return 0;
}

pub fn test_the_test_archives_use_what_they_were_built_to_use[&h](heap: &!h Heap) -> [heap] int {
    let long = rich(heap, 1);
    borrow long as &lr in {
        let e = tar.parse(heap, buffer.bytes(lr), 100);
        borrow e as &r in {
            test.assert_eq(tar.failure(r), 0);
            test.assert_eq(tar.count(r), 2);
            test.assert(bytes.equal(tar.name(r, 0), "a/very/long/name/that/the/header/field/could/hold/in/the/body/instead.txt"));
            test.assert(bytes.equal(tar.name(r, 1), "after"));
            test.assert_eq(tar.size(r, 0), 3);
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, long);
    let pax = rich(heap, 2);
    borrow pax as &pr in {
        let e = tar.parse(heap, buffer.bytes(pr), 100);
        borrow e as &r in {
            test.assert_eq(tar.failure(r), 0);
            test.assert_eq(tar.count(r), 2);
            test.assert(bytes.equal(tar.name(r, 0), "px/long/file.txt"));
            test.assert_eq(tar.size(r, 0), 7);
            test.assert(bytes.equal(tar.name(r, 1), "plain"));
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, pax);
    let odd = rich(heap, 3);
    borrow odd as &or in {
        let e = tar.parse(heap, buffer.bytes(or), 100);
        borrow e as &r in {
            test.assert_eq(tar.failure(r), 0);
            test.assert_eq(tar.count(r), 4);
            test.assert(tar.unsafe_at(r, 0));
            test.assert(bytes.equal(tar.name(r, 1), "a/b/c"));
            test.assert_eq(tar.kind(r, 2), 2);
            test.assert(tar.unsafe_at(r, 3));
        }
        tar.drop(heap, e);
    }
    buffer.drop(heap, odd);
    return 0;
}
