edition 7;

module archive.tar;

// `archive.tar` -- tar archives (POSIX ustar, with GNU long names and the pax `path` and
// `size` keys), read from memory and written to a buffer.
//
// docs/archive.md section 4.1 is the design. The reader never trusts a field: every offset
// is checked against the data before it is used, a size that cannot fit is `truncated`, and
// no input reaches a trap. Names are normalised (`.` and empty components are dropped) and
// a name that climbs (`..`), is absolute, or holds a NUL is flagged, not repaired.
//
// Kinds (what `kind` holds): 1 file, 2 directory, 3 hard link, 4 symbolic link, 5 device,
// 6 FIFO, 7 sparse file, 8 anything else.
//
// Failures of `parse` (`Entries.failure`):
//   0 none: the archive ended with its end marker
//   1 the data ends inside a header or body, or before the end marker
//   2 a header's checksum is not its bytes'
//   3 a header field is not readable (a size or mode that is not octal)
//   4 more than `most` entries

import std.buffer;
import std.bytes;
import std.vec;

pub fn block() -> [] int {
    return 512;
}

pub fn kind_file() -> [] int {
    return 1;
}

pub fn kind_directory() -> [] int {
    return 2;
}

pub fn kind_name(kind: int) -> [] &static [byte] {
    if kind == 1 {
        return "file";
    }
    if kind == 2 {
        return "directory";
    }
    if kind == 3 {
        return "hardlink";
    }
    if kind == 4 {
        return "symlink";
    }
    if kind == 5 {
        return "device";
    }
    if kind == 6 {
        return "fifo";
    }
    if kind == 7 {
        return "sparse";
    }
    return "other";
}

fn kind_of(flag: int) -> [] int {
    if flag == '0' || flag == 0 {
        return 1;
    }
    if flag == '5' {
        return 2;
    }
    if flag == '1' {
        return 3;
    }
    if flag == '2' {
        return 4;
    }
    if flag == '3' || flag == '4' {
        return 5;
    }
    if flag == '6' {
        return 6;
    }
    if flag == 'S' {
        return 7;
    }
    return 8;
}

// Whether a header of this kind is followed by `size` bytes of body.
fn has_body(flag: int) -> [] bool {
    return !(flag == '1' || flag == '2' || flag == '3' || flag == '4' || flag == '5' || flag == '6');
}

pub res struct Entries {
    names: buffer.Buffer,
    name_at: vec.Vec[int],
    name_len: vec.Vec[int],
    kind: vec.Vec[int],
    size: vec.Vec[int],
    body: vec.Vec[int],
    mode: vec.Vec[int],
    // Whether the name was flagged by `unsafe_name`.
    unsafe: vec.Vec[int],
    failure: int,
    // The offset of the header that failed.
    failure_at: int,
}

pub fn count[&e](entries: &e Entries) -> [] int {
    return vec.size(entries.kind);
}

pub fn name[&e](entries: &e Entries, i: int) -> [] &e [byte] {
    let at = vec.get(entries.name_at, i);
    return buffer.bytes(entries.names)[at..at + vec.get(entries.name_len, i)];
}

pub fn kind[&e](entries: &e Entries, i: int) -> [] int {
    return vec.get(entries.kind, i);
}

pub fn size[&e](entries: &e Entries, i: int) -> [] int {
    return vec.get(entries.size, i);
}

pub fn body[&e](entries: &e Entries, i: int) -> [] int {
    return vec.get(entries.body, i);
}

pub fn mode[&e](entries: &e Entries, i: int) -> [] int {
    return vec.get(entries.mode, i);
}

pub fn unsafe_at[&e](entries: &e Entries, i: int) -> [] bool {
    return vec.get(entries.unsafe, i) != 0;
}

pub fn failure[&e](entries: &e Entries) -> [] int {
    return entries.failure;
}

pub fn failure_at[&e](entries: &e Entries) -> [] int {
    return entries.failure_at;
}

pub fn drop[&h](heap: &!h Heap, entries: Entries) -> [heap] int {
    let Entries { names, name_at, name_len, kind, size, body, mode, unsafe, failure, failure_at } = entries;
    buffer.drop(heap, names);
    vec.drop(heap, name_at);
    vec.drop(heap, name_len);
    vec.drop(heap, kind);
    vec.drop(heap, size);
    vec.drop(heap, body);
    vec.drop(heap, mode);
    vec.drop(heap, unsafe);
    return failure;
}

// ---- header fields ---------------------------------------------------------------------

// An octal field: leading spaces, digits, then a NUL or a space. -1 when it is anything else.
fn octal[&d](data: &d [byte], at: int, width: int) -> [] int {
    var i = at;
    let end = at + width;
    while i < end && int_of(data[i]) == ' ' {
        i = i + 1;
    }
    if i >= end {
        return 0 - 1;
    }
    var value = 0;
    var digits = 0;
    while i < end && int_of(data[i]) >= '0' && int_of(data[i]) <= '7' {
        if digits >= 20 {
            return 0 - 1;
        }
        value = value * 8 + (int_of(data[i]) - '0');
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return 0 - 1;
    }
    if i < end && int_of(data[i]) != 0 && int_of(data[i]) != ' ' {
        return 0 - 1;
    }
    return value;
}

// Whether the 512 bytes at `at` are all zero.
fn is_zero[&d](data: &d [byte], at: int) -> [] bool {
    var i = 0;
    while i < 512 {
        if int_of(data[at + i]) != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn checksum_ok[&d](data: &d [byte], at: int) -> [] bool {
    var sum = 0;
    var i = 0;
    while i < 512 {
        if i >= 148 && i < 156 {
            sum = sum + 32;
        } else {
            sum = sum + int_of(data[at + i]);
        }
        i = i + 1;
    }
    return sum == octal(data, at + 148, 8);
}

// Bytes of `data[at..at + width]` up to the first NUL.
fn cstring[&d](data: &d [byte], at: int, width: int) -> [] &d [byte] {
    var n = 0;
    while n < width && int_of(data[at + n]) != 0 {
        n = n + 1;
    }
    return data[at..at + n];
}

fn round_up(n: int) -> [] int {
    return (n + 511) / 512 * 512;
}

// ---- names ---------------------------------------------------------------------------------

// Whether `name` is a name `extract` must refuse: absolute, holding a NUL, or with a `..`
// component. (`.` and empty components are dropped by `normalised`, not refused.)
pub fn unsafe_name[&n](name: &n [byte]) -> [] bool {
    if len(name) > 0 && int_of(name[0]) == '/' {
        return true;
    }
    var i = 0;
    var start = 0;
    while i <= len(name) {
        if i < len(name) && int_of(name[i]) == 0 {
            return true;
        }
        if i == len(name) || int_of(name[i]) == '/' {
            if i - start == 2 && int_of(name[start]) == '.' && int_of(name[start + 1]) == '.' {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// `name` without `.` and empty components, trailing slashes included: `./a//b/.` is `a/b`.
// A name of nothing but those is `.`.
pub fn normalised[&h, &n](heap: &!h Heap, name: &n [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(name) + 1);
    var start = 0;
    var i = 0;
    var any = false;
    while i <= len(name) {
        if i == len(name) || int_of(name[i]) == '/' {
            let part = name[start..i];
            if len(part) > 0 && !(len(part) == 1 && int_of(part[0]) == '.') {
                if any {
                    out = buffer.push(heap, out, byte_of('/'));
                }
                out = buffer.append(heap, out, part);
                any = true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if !any && len(name) > 0 && int_of(name[0]) != '/' {
        out = buffer.push(heap, out, byte_of('.'));
    }
    return out;
}

// ---- pax extended headers ----------------------------------------------------------------------

// The value of `key` in the pax records `body[at..at + size]` (`LEN key=value\n`, repeated),
// as a range of `body`, or (-1, -1).
fn pax_value[&d](data: &d [byte], at: int, size: int, key: &static [byte]) -> [] (int, int) {
    var p = at;
    let end = at + size;
    while p < end {
        var length = 0;
        var q = p;
        while q < end && int_of(data[q]) >= '0' && int_of(data[q]) <= '9' && length < 100000000 {
            length = length * 10 + (int_of(data[q]) - '0');
            q = q + 1;
        }
        if q >= end || int_of(data[q]) != ' ' || length < q - p + 2 || p + length > end {
            return (0 - 1, 0 - 1);
        }
        let record = data[q + 1..p + length - 1];
        let eq = bytes.find(record, "=");
        if eq >= 0 && bytes.equal(record[0..eq], key) {
            return (q + 1 + eq + 1, p + length - 1);
        }
        p = p + length;
    }
    return (0 - 1, 0 - 1);
}

fn decimal[&d](data: &d [byte], from: int, to: int) -> [] int {
    if to <= from || to - from > 18 {
        return 0 - 1;
    }
    var value = 0;
    var i = from;
    while i < to {
        if int_of(data[i]) < '0' || int_of(data[i]) > '9' {
            return 0 - 1;
        }
        value = value * 10 + (int_of(data[i]) - '0');
        i = i + 1;
    }
    return value;
}

// ---- the reader ------------------------------------------------------------------------------------

fn fail(e: Entries, why: int, at: int) -> [] Entries {
    let Entries { names, name_at, name_len, kind, size, body, mode, unsafe, failure, failure_at } = e;
    return Entries { names: names, name_at: name_at, name_len: name_len, kind: kind, size: size, body: body, mode: mode, unsafe: unsafe, failure: why, failure_at: at };
}

// `e` with one more entry, whose name is already in `e.names` at `held`.
fn add[&h, &c](heap: &!h Heap, e: Entries, clean: &c [byte], held: int, class: int, length: int, at: int, permissions: int, flagged: bool) -> [heap] Entries {
    var flag_value = 0;
    if flagged {
        flag_value = 1;
    }
    let Entries { names, name_at, name_len, kind, size, body, mode, unsafe, failure, failure_at } = e;
    return Entries { names: buffer.append(heap, names, clean), name_at: vec.push(heap, name_at, held), name_len: vec.push(heap, name_len, len(clean)), kind: vec.push(heap, kind, class), size: vec.push(heap, size, length), body: vec.push(heap, body, at), mode: vec.push(heap, mode, permissions), unsafe: vec.push(heap, unsafe, flag_value), failure: failure, failure_at: failure_at };
}

// The entries of a single file named `name` of `length` bytes at `at` in the data: what
// `archive` lists and extracts for a gzip that is not a tar.
pub fn single[&h, &n](heap: &!h Heap, name: &n [byte], length: int, at: int) -> [heap] Entries {
    let e = Entries { names: buffer.empty(heap, len(name) + 1), name_at: vec.empty(heap, 1, 0), name_len: vec.empty(heap, 1, 0), kind: vec.empty(heap, 1, 0), size: vec.empty(heap, 1, 0), body: vec.empty(heap, 1, 0), mode: vec.empty(heap, 1, 0), unsafe: vec.empty(heap, 1, 0), failure: 0, failure_at: 0 };
    return add(heap, e, name, 0, 1, length, at, 420, unsafe_name(name));
}

// Read every entry of the tar in `data`, at most `most`. The entries read before a failure are kept.
pub fn parse[&h, &d](heap: &!h Heap, data: &d [byte], most: int) -> [heap] Entries {
    var e = Entries { names: buffer.empty(heap, 256), name_at: vec.empty(heap, 16, 0), name_len: vec.empty(heap, 16, 0), kind: vec.empty(heap, 16, 0), size: vec.empty(heap, 16, 0), body: vec.empty(heap, 16, 0), mode: vec.empty(heap, 16, 0), unsafe: vec.empty(heap, 16, 0), failure: 0, failure_at: 0 };
    var at = 0;
    var going = true;
    // A name and a size that a long-name or pax header gives the next entry.
    var pending = buffer.empty(heap, 1);
    var has_pending = false;
    var pending_size = 0 - 1;
    // How much of `e.names` is used: where the next name starts.
    var names_size = 0;
    var seen = 0;
    while going {
        if at + 512 > len(data) {
            e = fail(e, 1, at);
            going = false;
        } else if is_zero(data, at) {
            going = false;
        } else if !checksum_ok(data, at) {
            e = fail(e, 2, at);
            going = false;
        } else {
            let flag = int_of(data[at + 156]);
            var size = octal(data, at + 124, 12);
            let mode = octal(data, at + 100, 8);
            if size < 0 || mode < 0 {
                e = fail(e, 3, at);
                going = false;
            } else {
                let body_at = at + 512;
                var advance = 512;
                if has_body(flag) {
                    advance = 512 + round_up(size);
                }
                if size > len(data) || body_at + (advance - 512) > len(data) {
                    e = fail(e, 1, at);
                    going = false;
                } else if flag == 'x' {
                    let (path_from, path_to) = pax_value(data, body_at, size, "path");
                    if path_from >= 0 {
                        buffer.drop(heap, pending);
                        pending = buffer.append(heap, buffer.empty(heap, path_to - path_from), data[path_from..path_to]);
                        has_pending = true;
                    }
                    let (size_from, size_to) = pax_value(data, body_at, size, "size");
                    if size_from >= 0 {
                        pending_size = decimal(data, size_from, size_to);
                    }
                    at = at + advance;
                } else if flag == 'L' {
                    buffer.drop(heap, pending);
                    pending = buffer.append(heap, buffer.empty(heap, size), cstring(data, body_at, size));
                    has_pending = true;
                    at = at + advance;
                } else if flag == 'g' || flag == 'K' {
                    at = at + advance;
                } else {
                    if pending_size >= 0 && has_body(flag) {
                        // A pax `size` overrides the field, which is too small for it.
                        size = pending_size;
                        advance = 512 + round_up(size);
                    }
                    pending_size = 0 - 1;
                    if body_at + (advance - 512) > len(data) {
                        e = fail(e, 1, at);
                        going = false;
                    } else if seen >= most {
                        e = fail(e, 4, at);
                        going = false;
                    } else {
                        // The name: a long name or a pax path, else the prefix and the name.
                        var raw = buffer.empty(heap, 256);
                        if has_pending {
                            borrow pending as &p in {
                                raw = buffer.append(heap, raw, buffer.bytes(p));
                            }
                        } else {
                            let has_prefix = bytes.equal(data[at + 257..at + 262], "ustar") && int_of(data[at + 345]) != 0;
                            if has_prefix {
                                raw = buffer.append(heap, raw, cstring(data, at + 345, 155));
                                raw = buffer.push(heap, raw, byte_of('/'));
                            }
                            raw = buffer.append(heap, raw, cstring(data, at, 100));
                        }
                        buffer.drop(heap, pending);
                        pending = buffer.empty(heap, 1);
                        has_pending = false;
                        var flagged = false;
                        borrow raw as &r in {
                            flagged = unsafe_name(buffer.bytes(r));
                            let clean = normalised(heap, buffer.bytes(r));
                            borrow clean as &c in {
                                let held = names_size;
                                names_size = names_size + buffer.size(c);
                                e = add(heap, e, buffer.bytes(c), held, kind_of(flag), size, body_at, mode, flagged);
                            }
                            buffer.drop(heap, clean);
                        }
                        buffer.drop(heap, raw);
                        seen = seen + 1;
                        at = at + advance;
                    }
                }
            }
        }
    }
    buffer.drop(heap, pending);
    return e;
}

// Whether `data` begins with a whole block of zeros.
pub fn starts_zero[&d](data: &d [byte]) -> [] bool {
    return len(data) >= 512 && is_zero(data, 0);
}

// Whether `data` starts like a tar: a header whose checksum is its bytes', or two zero blocks.
pub fn looks_like_tar[&d](data: &d [byte]) -> [] bool {
    if len(data) < 512 {
        return false;
    }
    if is_zero(data, 0) {
        return len(data) >= 1024 && is_zero(data, 512);
    }
    return checksum_ok(data, 0);
}

// ---- the incremental reader ----------------------------------------------------------------------------------
//
// `scan_feed` reads a tar a piece at a time, in memory that does not grow with the archive: a 512-byte header buffer, the
// body of one pax or long-name header (at most 64 KiB), and the name of one entry. It makes the entries `parse` makes, with
// the same names, kinds, sizes, flags and failures, in the same order, and an entry is made only when its whole body (to the
// block) has been seen, as `parse` makes it only when the body is in the data. docs/archive.md section 12.1.
//
// Differences from `parse`, all stated there: the body of a pax or long-name header over 64 KiB is `failure 3` (a header
// field that cannot be read), and the entries of one `scan_feed` come back in an `Entries` of their own, whose `body` offsets
// are 0.

pub res struct Scan {
    hdr: Box[[byte]],
    st: Box[[int]],
    // The body of a pax or long-name header being collected.
    side: buffer.Buffer,
    // A name (long-name header, pax path) for the next entry.
    pending: buffer.Buffer,
    // The name of the entry waiting for its body to pass.
    cur: buffer.Buffer,
}

fn c_phase() -> [] int {
    return 0;
}

// Bytes of the header held, 0 to 511.
fn c_hn() -> [] int {
    return 1;
}

// Bytes of the body being collected or skipped that are still to come.
fn c_remaining() -> [] int {
    return 2;
}

// Bytes seen, and the offset of the header being read or waited on.
fn c_pos() -> [] int {
    return 3;
}

fn c_header_at() -> [] int {
    return 4;
}

fn c_seen() -> [] int {
    return 5;
}

fn c_most() -> [] int {
    return 6;
}

fn c_has_pending() -> [] int {
    return 7;
}

// A pax `size` for the next entry, or -1.
fn c_pending_size() -> [] int {
    return 8;
}

fn c_failure() -> [] int {
    return 9;
}

fn c_failure_at() -> [] int {
    return 10;
}

// An entry waits for its body to pass: its kind, size, mode, and whether its name was flagged.
fn c_held() -> [] int {
    return 11;
}

fn c_kind() -> [] int {
    return 12;
}

fn c_size() -> [] int {
    return 13;
}

fn c_mode() -> [] int {
    return 14;
}

fn c_flagged() -> [] int {
    return 15;
}

// The flag of the pax or long-name header being collected, its declared size, and the padding after it.
fn c_flag() -> [] int {
    return 16;
}

fn c_declared() -> [] int {
    return 17;
}

fn c_pad() -> [] int {
    return 18;
}

fn ph_header() -> [] int {
    return 0;
}

fn ph_collect() -> [] int {
    return 1;
}

fn ph_skip() -> [] int {
    return 2;
}

// After the end marker: the rest is ignored. And after a failure.
fn ph_end() -> [] int {
    return 3;
}

fn ph_failed() -> [] int {
    return 4;
}

fn collect_cap() -> [] int {
    return 65536;
}

// An `Entries` with nothing in it.
pub fn entries_empty[&h](heap: &!h Heap) -> [heap] Entries {
    return Entries { names: buffer.empty(heap, 256), name_at: vec.empty(heap, 16, 0), name_len: vec.empty(heap, 16, 0), kind: vec.empty(heap, 16, 0), size: vec.empty(heap, 16, 0), body: vec.empty(heap, 16, 0), mode: vec.empty(heap, 16, 0), unsafe: vec.empty(heap, 16, 0), failure: 0, failure_at: 0 };
}

// A scanner that makes at most `most` entries.
pub fn scan_open[&h](heap: &!h Heap, most: int) -> [heap] Scan {
    let st = box_slice(heap, 24, 0);
    borrow mut st as &!w in {
        contents(w)[c_most()] = most;
        contents(w)[c_pending_size()] = 0 - 1;
    }
    return Scan { hdr: box_slice(heap, 512, byte_of(0)), st: st, side: buffer.empty(heap, 256), pending: buffer.empty(heap, 1), cur: buffer.empty(heap, 256) };
}

pub fn scan_drop[&h](heap: &!h Heap, sc: Scan) -> [heap] int {
    let Scan { hdr, st, side, pending, cur } = sc;
    unbox_slice(heap, hdr);
    unbox_slice(heap, st);
    buffer.drop(heap, side);
    buffer.drop(heap, pending);
    buffer.drop(heap, cur);
    return 0;
}

// The failure so far (as `Entries.failure`: 0 none) and the offset it was found at.
pub fn scan_failure[&i](sc: &i Scan) -> [] int {
    return contents(sc.st)[c_failure()];
}

pub fn scan_failure_at[&i](sc: &i Scan) -> [] int {
    return contents(sc.st)[c_failure_at()];
}

// Whether the end marker has been seen.
pub fn scan_ended[&i](sc: &i Scan) -> [] bool {
    return contents(sc.st)[c_phase()] == ph_end();
}

fn stop[&y](st: &!y [int], why: int) -> [] int {
    st[c_failure()] = why;
    st[c_failure_at()] = st[c_header_at()];
    st[c_phase()] = ph_failed();
    return why;
}

// The entry waiting for its body is complete: make it.
fn emit_held[&h, &y, &k](heap: &!h Heap, st: &!y [int], cur: &k buffer.Buffer, e: Entries) -> [heap] Entries {
    st[c_held()] = 0;
    if st[c_seen()] >= st[c_most()] {
        stop(st, 4);
        return e;
    }
    var held = 0;
    borrow e as &er in {
        held = buffer.size(er.names);
    }
    st[c_seen()] = st[c_seen()] + 1;
    return add(heap, e, buffer.bytes(cur), held, st[c_kind()], st[c_size()], 0, st[c_mode()], st[c_flagged()] != 0);
}

// A pax or long-name header's body is in `side`: take what it says for the next entry.
fn collected[&h, &y, &s](heap: &!h Heap, st: &!y [int], side: &s buffer.Buffer, pending: buffer.Buffer) -> [heap] buffer.Buffer {
    var p = pending;
    let size = st[c_declared()];
    let data = buffer.bytes(side);
    if st[c_flag()] == 'x' {
        let (path_from, path_to) = pax_value(data, 0, size, "path");
        if path_from >= 0 {
            buffer.drop(heap, p);
            p = buffer.append(heap, buffer.empty(heap, path_to - path_from), data[path_from..path_to]);
            st[c_has_pending()] = 1;
        }
        let (size_from, size_to) = pax_value(data, 0, size, "size");
        if size_from >= 0 {
            st[c_pending_size()] = decimal(data, size_from, size_to);
        }
    } else {
        buffer.drop(heap, p);
        p = buffer.append(heap, buffer.empty(heap, size), cstring(data, 0, size));
        st[c_has_pending()] = 1;
    }
    if st[c_pad()] > 0 {
        st[c_remaining()] = st[c_pad()];
        st[c_phase()] = ph_skip();
    } else {
        st[c_phase()] = ph_header();
    }
    return p;
}

// A whole 512-byte header is in `hdr`.
fn header_step[&h, &x, &y](heap: &!h Heap, hdr: &x [byte], st: &!y [int], side: buffer.Buffer, pending: buffer.Buffer, cur: buffer.Buffer, e: Entries) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, Entries) {
    var sd = side;
    var p = pending;
    var c = cur;
    var found = e;
    if is_zero(hdr, 0) {
        st[c_phase()] = ph_end();
        return (sd, p, c, found);
    }
    if !checksum_ok(hdr, 0) {
        stop(st, 2);
        return (sd, p, c, found);
    }
    let flag = int_of(hdr[156]);
    var size = octal(hdr, 124, 12);
    let mode = octal(hdr, 100, 8);
    if size < 0 || mode < 0 {
        stop(st, 3);
        return (sd, p, c, found);
    }
    var body = 0;
    if has_body(flag) {
        body = round_up(size);
    }
    if flag == 'x' || flag == 'L' {
        if size > collect_cap() {
            // Too big to keep: skip it, and refuse it if it is all there (failure 3); if the data ends first, the archive is cut
            // (failure 1), which is what `parse` says of a body that is not there.
            st[c_held()] = 2;
            st[c_remaining()] = body;
            st[c_phase()] = ph_skip();
            return (sd, p, c, found);
        }
        borrow mut sd as &!w in {
            buffer.clear(w);
        }
        st[c_flag()] = flag;
        st[c_declared()] = size;
        st[c_pad()] = body - size;
        st[c_remaining()] = size;
        st[c_phase()] = ph_collect();
        if size == 0 {
            borrow sd as &sr in {
                p = collected(heap, st, sr, p);
            }
        }
    } else if flag == 'g' || flag == 'K' {
        if body > 0 {
            st[c_remaining()] = body;
            st[c_phase()] = ph_skip();
        }
    } else {
        if st[c_pending_size()] >= 0 && has_body(flag) {
            // A pax `size` overrides the field, which is too small for it.
            size = st[c_pending_size()];
            body = round_up(size);
        }
        st[c_pending_size()] = 0 - 1;
        // The name: a long name or a pax path, else the prefix and the name.
        var raw = buffer.empty(heap, 256);
        if st[c_has_pending()] == 1 {
            borrow p as &pr in {
                raw = buffer.append(heap, raw, buffer.bytes(pr));
            }
        } else {
            let has_prefix = bytes.equal(hdr[257..262], "ustar") && int_of(hdr[345]) != 0;
            if has_prefix {
                raw = buffer.append(heap, raw, cstring(hdr, 345, 155));
                raw = buffer.push(heap, raw, byte_of('/'));
            }
            raw = buffer.append(heap, raw, cstring(hdr, 0, 100));
        }
        buffer.drop(heap, p);
        p = buffer.empty(heap, 1);
        st[c_has_pending()] = 0;
        var flagged = 0;
        borrow raw as &r in {
            if unsafe_name(buffer.bytes(r)) {
                flagged = 1;
            }
            buffer.drop(heap, c);
            c = normalised(heap, buffer.bytes(r));
        }
        buffer.drop(heap, raw);
        st[c_held()] = 1;
        st[c_kind()] = kind_of(flag);
        st[c_size()] = size;
        st[c_mode()] = mode;
        st[c_flagged()] = flagged;
        if body > 0 {
            st[c_remaining()] = body;
            st[c_phase()] = ph_skip();
        } else {
            borrow c as &cr in {
                found = emit_held(heap, st, cr, found);
            }
        }
    }
    return (sd, p, c, found);
}

// Read `data`, the next piece of the tar, and add the entries it completes to `found`.
pub fn scan_feed[&h, &d](heap: &!h Heap, sc: Scan, data: &d [byte], found: Entries) -> [heap] (Scan, Entries) {
    let Scan { hdr, st, side, pending, cur } = sc;
    var sd = side;
    var p = pending;
    var c = cur;
    var e = found;
    let n = len(data);
    var i = 0;
    var h_box = hdr;
    var s_box = st;
    borrow mut h_box as &!hw in {
        borrow mut s_box as &!sw in {
            let hb = contents(hw);
            let s = contents(sw);
            while i < n && s[c_phase()] < ph_end() {
                let phase = s[c_phase()];
                if phase == ph_header() {
                    var take = 512 - s[c_hn()];
                    if take > n - i {
                        take = n - i;
                    }
                    copy_into(hb[s[c_hn()]..s[c_hn()] + take], data[i..i + take]);
                    s[c_hn()] = s[c_hn()] + take;
                    s[c_pos()] = s[c_pos()] + take;
                    i = i + take;
                    if s[c_hn()] == 512 {
                        s[c_hn()] = 0;
                        s[c_header_at()] = s[c_pos()] - 512;
                        let (a, b, cc, ee) = header_step(heap, hb, s, sd, p, c, e);
                        sd = a;
                        p = b;
                        c = cc;
                        e = ee;
                    }
                } else if phase == ph_collect() {
                    var take = s[c_remaining()];
                    if take > n - i {
                        take = n - i;
                    }
                    sd = buffer.append(heap, sd, data[i..i + take]);
                    s[c_remaining()] = s[c_remaining()] - take;
                    s[c_pos()] = s[c_pos()] + take;
                    i = i + take;
                    if s[c_remaining()] == 0 {
                        borrow sd as &sr in {
                            p = collected(heap, s, sr, p);
                        }
                    }
                } else {
                    var take = s[c_remaining()];
                    if take > n - i {
                        take = n - i;
                    }
                    s[c_remaining()] = s[c_remaining()] - take;
                    s[c_pos()] = s[c_pos()] + take;
                    i = i + take;
                    if s[c_remaining()] == 0 {
                        s[c_phase()] = ph_header();
                        if s[c_held()] == 1 {
                            borrow c as &cr in {
                                e = emit_held(heap, s, cr, e);
                            }
                        } else if s[c_held()] == 2 {
                            s[c_held()] = 0;
                            stop(s, 3);
                        }
                    }
                }
            }
        }
    }
    return (Scan { hdr: h_box, st: s_box, side: sd, pending: p, cur: c }, e);
}

// The data has ended: a tar that has not reached its end marker is cut (failure 1, at the header that is missing or whose
// body is). Answers the failure, 0 for none.
pub fn scan_finish[&i](sc: &!i Scan) -> [] int {
    let s = contents(sc.st);
    if s[c_failure()] != 0 || s[c_phase()] == ph_end() {
        return s[c_failure()];
    }
    s[c_failure()] = 1;
    if s[c_phase()] == ph_header() {
        s[c_failure_at()] = s[c_pos()] - s[c_hn()];
    } else {
        s[c_failure_at()] = s[c_header_at()];
    }
    return 1;
}

// ---- the writer -------------------------------------------------------------------------------------------

fn put_octal[&h](heap: &!h Heap, b: buffer.Buffer, value: int, digits: int) -> [heap] buffer.Buffer {
    var o = b;
    var shift = (digits - 1) * 3;
    while shift >= 0 {
        o = buffer.push(heap, o, byte_of('0' + (value >> shift & 7)));
        shift = shift - 3;
    }
    return o;
}

fn pad_to[&h](heap: &!h Heap, b: buffer.Buffer, width: int, used: int) -> [heap] buffer.Buffer {
    var o = b;
    var i = used;
    while i < width {
        o = buffer.push(heap, o, byte_of(0));
        i = i + 1;
    }
    return o;
}

// Where to split `name` into a prefix (at most 155) and a name (at most 100): the offset of
// the `/` between them, or -1 when `name` fits in 100 bytes, or -2 when it cannot be split.
pub fn split_point[&n](name: &n [byte]) -> [] int {
    if len(name) <= 100 {
        return 0 - 1;
    }
    var i = len(name) - 1;
    while i > 0 {
        if int_of(name[i]) == '/' && i <= 155 && len(name) - i - 1 <= 100 && len(name) - i - 1 > 0 {
            return i;
        }
        i = i - 1;
    }
    return 0 - 2;
}

// Append the header of one entry: a file (`directory` false) of `size` bytes, or a directory.
// `mode` is the permission bits. The owner and group are 0 and the time is 0, so the bytes are a
// function of the arguments. Answers the buffer and 0, or 1 when the name cannot be written.
pub fn header[&h, &n](heap: &!h Heap, out: buffer.Buffer, name: &n [byte], size: int, directory: bool, mode: int) -> [heap] (buffer.Buffer, int) {
    let cut = split_point(name);
    if cut == 0 - 2 || len(name) > 255 {
        return (out, 1);
    }
    var shown = name;
    var prefix = name[0..0];
    if cut >= 0 {
        prefix = name[0..cut];
        shown = name[cut + 1..len(name)];
    }
    var h = buffer.empty(heap, 512);
    h = buffer.append(heap, h, shown);
    h = pad_to(heap, h, 100, len(shown));
    h = put_octal(heap, h, mode, 7);
    h = buffer.push(heap, h, byte_of(0));
    h = put_octal(heap, h, 0, 7);
    h = buffer.push(heap, h, byte_of(0));
    h = put_octal(heap, h, 0, 7);
    h = buffer.push(heap, h, byte_of(0));
    var length = size;
    if directory {
        length = 0;
    }
    h = put_octal(heap, h, length, 11);
    h = buffer.push(heap, h, byte_of(0));
    h = put_octal(heap, h, 0, 11);
    h = buffer.push(heap, h, byte_of(0));
    // The checksum, as eight spaces for now.
    h = buffer.append(heap, h, "        ");
    if directory {
        h = buffer.push(heap, h, byte_of('5'));
    } else {
        h = buffer.push(heap, h, byte_of('0'));
    }
    h = pad_to(heap, h, 257, 157);
    // The link name is 100 bytes of nothing; the magic and version come after it.
    h = buffer.append(heap, h, "ustar");
    h = buffer.push(heap, h, byte_of(0));
    h = buffer.append(heap, h, "00");
    h = pad_to(heap, h, 345, 265);
    h = buffer.append(heap, h, prefix);
    h = pad_to(heap, h, 512, 345 + len(prefix));
    // Sum it with the checksum field as spaces, and write it over them: six digits, a NUL, a space.
    var sum = 0;
    borrow h as &r in {
        let all = buffer.bytes(r);
        var i = 0;
        while i < 512 {
            sum = sum + int_of(all[i]);
            i = i + 1;
        }
    }
    var result = out;
    var fixed = buffer.empty(heap, 512);
    borrow h as &r in {
        let all = buffer.bytes(r);
        fixed = buffer.append(heap, fixed, all[0..148]);
        fixed = put_octal(heap, fixed, sum, 6);
        fixed = buffer.push(heap, fixed, byte_of(0));
        fixed = buffer.push(heap, fixed, byte_of(' '));
        fixed = buffer.append(heap, fixed, all[156..512]);
    }
    buffer.drop(heap, h);
    borrow fixed as &f in {
        result = buffer.append(heap, result, buffer.bytes(f));
    }
    buffer.drop(heap, fixed);
    return (result, 0);
}

// The bytes of a file's body and the zeros that round it up to a block.
pub fn body_of[&h, &d](heap: &!h Heap, out: buffer.Buffer, data: &d [byte]) -> [heap] buffer.Buffer {
    var o = buffer.append(heap, out, data);
    return pad_to(heap, o, round_up(len(data)), len(data));
}

// The end marker: two zero blocks.
pub fn finish[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = out;
    var used = 0;
    borrow o as &r in {
        used = buffer.size(r);
    }
    return pad_to(heap, o, used + 1024, used);
}
