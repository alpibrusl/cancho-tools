edition 7;

module archive.zstd;

// `archive.zstd` -- one Zstandard frame decompressed from memory (docs/archive.md section 18; the format is RFC 8878).
//
// A frame is a header (the window size and, optionally, the content size and a dictionary id), blocks, and an optional XXH64
// checksum. A block is raw, a run of one byte, or compressed: a literals section (raw, one byte repeated, or Huffman-coded with a
// tree sent in the block or kept from a previous one, in one stream or four) and a sequences section (finite-state-entropy coded
// triples of literal length, match length and offset, with the three most recent offsets kept between blocks). The decoded
// content is its own window, since all of it is held.
//
// Nothing is trusted: every size, count, table, index and offset is checked; a match may not reach before the start of the
// content or past the window; every bitstream must be consumed exactly; the expansion is bounded by `limit`; the content checksum is
// verified when there is one; and bytes after the frame (a second frame, a skippable frame) are refused as they are for gzip.
//
// Not read: a frame that needs a dictionary (`unsupported`).
//
// Statuses (the numbers `flate.gunzip` uses): 0 whole, 1 invalid, 2 truncated, 3 past `limit`, 10 not zstd, 11 unsupported,
// 13 the checksum does not match, 15 bytes after the frame.

import std.buffer;

pub fn looks_like[&s](src: &s [byte]) -> [] bool {
    return len(src) >= 4 && int_of(src[0]) == 0x28 && int_of(src[1]) == 0xb5 && int_of(src[2]) == 0x2f && int_of(src[3]) == 0xfd;
}

fn le_n[&s](src: &s [byte], at: int, n: int) -> [] int {
    var v = 0;
    var i = 0;
    while i < n {
        v = v | int_of(src[at + i]) << 8 * i;
        i = i + 1;
    }
    return v;
}

// The position of the highest set bit of `v` (v > 0).
fn high_bit(v: int) -> [] int {
    var n = 0;
    var x = v;
    while x > 1 {
        x = x >> 1;
        n = n + 1;
    }
    return n;
}

// ---- XXH64, by 64-bit wrapping arithmetic -----------------------------------------------------------------------------------

fn low_mask(k: int) -> [] int {
    if k >= 63 {
        return 0x7fffffffffffffff;
    }
    return (1 << k) - 1;
}

fn lshr(x: int, n: int) -> [] int {
    if n == 0 {
        return x;
    }
    return x >> n & low_mask(64 - n);
}

fn rotl(x: int, n: int) -> [] int {
    return x << n | lshr(x, 64 - n);
}

fn p1() -> [] int {
    return 0 - 7046029288634856825;
}

fn p2() -> [] int {
    return 0 - 4417276706812531889;
}

fn p3() -> [] int {
    return 1609587929392839161;
}

fn p4() -> [] int {
    return 0 - 8796714831421723037;
}

fn p5() -> [] int {
    return 2870177450012600261;
}

fn xround(acc: int, input: int) -> [] int {
    return wrapping_mul(rotl(wrapping_add(acc, wrapping_mul(input, p2())), 31), p1());
}

fn merge(acc: int, v: int) -> [] int {
    return wrapping_add(wrapping_mul(acc ^ xround(0, v), p1()), p4());
}

fn le64[&s](src: &s [byte], at: int) -> [] int {
    var v = 0;
    var i = 7;
    while i >= 0 {
        v = v << 8 | int_of(src[at + i]);
        i = i - 1;
    }
    return v;
}

// XXH64 of `data` with seed 0.
fn xxh64[&d](data: &d [byte]) -> [] int {
    let n = len(data);
    var at = 0;
    var h = 0;
    if n >= 32 {
        var v1 = wrapping_add(p1(), p2());
        var v2 = p2();
        var v3 = 0;
        var v4 = wrapping_sub(0, p1());
        while at + 32 <= n {
            v1 = xround(v1, le64(data, at));
            v2 = xround(v2, le64(data, at + 8));
            v3 = xround(v3, le64(data, at + 16));
            v4 = xround(v4, le64(data, at + 24));
            at = at + 32;
        }
        h = wrapping_add(wrapping_add(rotl(v1, 1), rotl(v2, 7)), wrapping_add(rotl(v3, 12), rotl(v4, 18)));
        h = merge(h, v1);
        h = merge(h, v2);
        h = merge(h, v3);
        h = merge(h, v4);
    } else {
        h = p5();
    }
    h = wrapping_add(h, n);
    while at + 8 <= n {
        h = h ^ xround(0, le64(data, at));
        h = wrapping_add(wrapping_mul(rotl(h, 27), p1()), p4());
        at = at + 8;
    }
    if at + 4 <= n {
        h = h ^ wrapping_mul(le_n(data, at, 4), p1());
        h = wrapping_add(wrapping_mul(rotl(h, 23), p2()), p3());
        at = at + 4;
    }
    while at < n {
        h = h ^ wrapping_mul(int_of(data[at]), p5());
        h = wrapping_mul(rotl(h, 11), p1());
        at = at + 1;
    }
    h = h ^ lshr(h, 33);
    h = wrapping_mul(h, p2());
    h = h ^ lshr(h, 29);
    h = wrapping_mul(h, p3());
    h = h ^ lshr(h, 32);
    return h;
}

// ---- bit readers -------------------------------------------------------------------------------------------------------------------

// `k` bits (at most 32) of `src`, from bit `from` (bit 0 is the lowest bit of byte 0), the lowest first.
fn bits_at[&s](src: &s [byte], from: int, k: int) -> [] int {
    if k == 0 {
        return 0;
    }
    let first = from / 8;
    let last = (from + k - 1) / 8;
    var acc = 0;
    var i = first;
    while i <= last {
        acc = acc | int_of(src[i]) << 8 * (i - first);
        i = i + 1;
    }
    return acc >> from - first * 8 & (1 << k) - 1;
}

// The bits of a backward stream `src[start..end]` before its end marker: how many there are, or -1 when the last byte is zero.
fn back_len[&s](src: &s [byte], start: int, end: int) -> [] int {
    if end <= start {
        return 0 - 1;
    }
    let last = int_of(src[end - 1]);
    if last == 0 {
        return 0 - 1;
    }
    return (end - 1 - start) * 8 + high_bit(last);
}

// ---- finite state entropy --------------------------------------------------------------------------------------------------------

// Read an FSE table description at `src[start..end]` into `norm`; answers the accuracy log, the number of symbols, and the bytes
// used, or (-1, 0, 0). The symbols may not be more than `max_sym + 1`, nor the accuracy more than `max_al`.
fn read_norm[&s, &n](src: &s [byte], start: int, end: int, max_sym: int, max_al: int, norm: &!n [int]) -> [] (int, int, int) {
    let total_bits = (end - start) * 8;
    if total_bits < 4 {
        return (0 - 1, 0, 0);
    }
    let al = bits_at(src, start * 8, 4) + 5;
    if al > max_al {
        return (0 - 1, 0, 0);
    }
    var bit = 4;
    var remaining = (1 << al) + 1;
    var threshold = 1 << al;
    var nb_bits = al + 1;
    var sym = 0;
    var previous0 = false;
    var ok = true;
    while ok && remaining > 1 && sym <= max_sym {
        if previous0 {
            var n0 = sym;
            var more = true;
            while more && ok {
                if bit + 2 > total_bits {
                    ok = false;
                } else {
                    let two = bits_at(src, start * 8 + bit, 2);
                    bit = bit + 2;
                    n0 = n0 + two;
                    if two != 3 {
                        more = false;
                    }
                }
            }
            if n0 > max_sym + 1 {
                ok = false;
            }
            while ok && sym < n0 {
                norm[sym] = 0;
                sym = sym + 1;
            }
        }
        if ok {
            if bit > total_bits {
                ok = false;
            } else {
                let max = 2 * threshold - 1 - remaining;
                var avail = nb_bits;
                if bit + avail > total_bits {
                    avail = total_bits - bit;
                }
                let raw = bits_at(src, start * 8 + bit, avail);
                var count = 0;
                if raw & threshold - 1 < max {
                    count = raw & threshold - 1;
                    bit = bit + nb_bits - 1;
                } else {
                    count = raw & 2 * threshold - 1;
                    if count >= threshold {
                        count = count - max;
                    }
                    bit = bit + nb_bits;
                }
                count = count - 1;
                if count < 0 {
                    remaining = remaining + count;
                } else {
                    remaining = remaining - count;
                }
                norm[sym] = count;
                sym = sym + 1;
                previous0 = count == 0;
                while remaining < threshold {
                    nb_bits = nb_bits - 1;
                    threshold = threshold >> 1;
                }
            }
        }
    }
    if !ok || remaining != 1 || bit > total_bits {
        return (0 - 1, 0, 0);
    }
    return (al, sym, (bit + 7) / 8);
}

// Build the decoding table at offset `off` of `sym`, `nbits` and `base` from the normalised counts `norm[0..nsym]` for accuracy `al`.
// Answers 0, or 1 when the counts are not a distribution of that accuracy.
fn build_table[&n, &y, &b, &a, &x](norm: &n [int], nsym: int, al: int, off: int, sym: &!y [int], nbits: &!b [int], base: &!a [int], next: &!x [int]) -> [] int {
    let size = 1 << al;
    var high = size - 1;
    var s = 0;
    while s < nsym {
        if norm[s] == 0 - 1 {
            sym[off + high] = s;
            high = high - 1;
            next[s] = 1;
        } else {
            next[s] = norm[s];
        }
        s = s + 1;
    }
    let step = (size >> 1) + (size >> 3) + 3;
    let mask = size - 1;
    var pos = 0;
    s = 0;
    while s < nsym {
        var i = 0;
        while i < norm[s] {
            sym[off + pos] = s;
            pos = pos + step & mask;
            while pos > high {
                pos = pos + step & mask;
            }
            i = i + 1;
        }
        s = s + 1;
    }
    if pos != 0 {
        return 1;
    }
    var u = 0;
    while u < size {
        let symbol = sym[off + u];
        let ns = next[symbol];
        next[symbol] = ns + 1;
        let nb = al - high_bit(ns);
        nbits[off + u] = nb;
        base[off + u] = (ns << nb) - size;
        u = u + 1;
    }
    return 0;
}

// A table of one symbol that costs no bits.
fn build_rle[&y, &b, &a](symbol: int, off: int, sym: &!y [int], nbits: &!b [int], base: &!a [int]) -> [] int {
    sym[off] = symbol;
    nbits[off] = 0;
    base[off] = 0;
    return 0;
}

// ---- Huffman -------------------------------------------------------------------------------------------------------------------------

// Read a Huffman tree description at `src[p..end]` and build the decoding table `hsym`/`hnb` (2^11 entries). `weights` holds 256
// ints, `norm` 64, and the four arrays hold the FSE table used for the weights at offset 1536. Answers the bytes the description
// takes and the number of bits of the longest code, or (-1, 0).
fn read_tree[&s, &w, &y, &c, &a, &x, &n, &h, &g](src: &s [byte], p: int, end: int, weights: &!w [int], sym: &!y [int], nbits: &!c [int], base: &!a [int], next: &!x [int], norm: &!n [int], hsym: &!h [int], hnb: &!g [int]) -> [] (int, int) {
    if p >= end {
        return (0 - 1, 0);
    }
    let header = int_of(src[p]);
    var count = 0;
    var used = 0;
    if header >= 128 {
        count = header - 127;
        used = 1 + (count + 1) / 2;
        if p + used > end {
            return (0 - 1, 0);
        }
        var i = 0;
        while i < count {
            let b = int_of(src[p + 1 + i / 2]);
            if i % 2 == 0 {
                weights[i] = b >> 4;
            } else {
                weights[i] = b & 15;
            }
            i = i + 1;
        }
    } else {
        used = 1 + header;
        if header == 0 || p + used > end {
            return (0 - 1, 0);
        }
        let (al, nsym, norm_bytes) = read_norm(src, p + 1, p + used, 12, 6, norm);
        if al < 0 || build_table(norm, nsym, al, 1536, sym, nbits, base, next) != 0 {
            return (0 - 1, 0);
        }
        let start = p + 1 + norm_bytes;
        let stream_end = p + used;
        var pos = back_len(src, start, stream_end);
        if pos < 0 || pos < 2 * al {
            return (0 - 1, 0);
        }
        pos = pos - al;
        var s1 = bits_at(src, start * 8 + pos, al);
        pos = pos - al;
        var s2 = bits_at(src, start * 8 + pos, al);
        var done = false;
        while !done {
            if count >= 255 {
                return (0 - 1, 0);
            }
            weights[count] = sym[1536 + s1];
            count = count + 1;
            let nb1 = nbits[1536 + s1];
            if pos < nb1 {
                weights[count] = sym[1536 + s2];
                count = count + 1;
                done = true;
            } else {
                pos = pos - nb1;
                s1 = base[1536 + s1] + bits_at(src, start * 8 + pos, nb1);
                if count >= 255 {
                    return (0 - 1, 0);
                }
                weights[count] = sym[1536 + s2];
                count = count + 1;
                let nb2 = nbits[1536 + s2];
                if pos < nb2 {
                    weights[count] = sym[1536 + s1];
                    count = count + 1;
                    done = true;
                } else {
                    pos = pos - nb2;
                    s2 = base[1536 + s2] + bits_at(src, start * 8 + pos, nb2);
                }
            }
        }
    }
    // The weights give every code's length; the last symbol's weight is what makes the total a power of two.
    var total = 0;
    var i = 0;
    while i < count {
        if weights[i] > 11 {
            return (0 - 1, 0);
        }
        if weights[i] > 0 {
            total = total + (1 << weights[i] - 1);
        }
        i = i + 1;
    }
    if total == 0 {
        return (0 - 1, 0);
    }
    let max_bits = high_bit(total) + 1;
    let rest = (1 << max_bits) - total;
    if max_bits > 11 || rest == 0 || rest & rest - 1 != 0 || count >= 256 {
        return (0 - 1, 0);
    }
    weights[count] = high_bit(rest) + 1;
    count = count + 1;
    var index = 0;
    var weight = 1;
    while weight <= max_bits {
        var symbol = 0;
        while symbol < count {
            if weights[symbol] == weight {
                var k = 0;
                while k < 1 << weight - 1 {
                    hsym[index + k] = symbol;
                    hnb[index + k] = max_bits + 1 - weight;
                    k = k + 1;
                }
                index = index + (1 << weight - 1);
            }
            symbol = symbol + 1;
        }
        weight = weight + 1;
    }
    return (used, max_bits);
}

// Decode `count` literals from the backward stream `src[start..end]` into `out[at..]`. Answers 0, or 1 when the stream is not exactly
// what the symbols took.
fn huffman_stream[&s, &o, &h, &g](src: &s [byte], start: int, end: int, count: int, out: &!o [byte], at: int, hsym: &h [int], hnb: &g [int], max_bits: int) -> [] int {
    var pos = back_len(src, start, end);
    if pos < 0 {
        return 1;
    }
    var i = 0;
    while i < count {
        var index = 0;
        if pos >= max_bits {
            index = bits_at(src, start * 8 + pos - max_bits, max_bits);
        } else {
            index = bits_at(src, start * 8, pos) << max_bits - pos;
        }
        let nb = hnb[index];
        if nb > pos {
            return 1;
        }
        pos = pos - nb;
        out[at + i] = byte_of(hsym[index]);
        i = i + 1;
    }
    if pos != 0 {
        return 1;
    }
    return 0;
}

// ---- the fixed tables of sequences ---------------------------------------------------------------------------------------------

// The default distribution of codes `which` (0 literal lengths, 1 offsets, 2 match lengths), one character a count: '0' is -1, '1' is 0.
fn default_norm(which: int) -> [] &static [byte] {
    if which == 0 {
        return "543333333333322233333333343222220000";
    }
    if which == 1 {
        return "22222233322222222222222200000";
    }
    return "25433333322222222222222222222222222222222222220000000";
}

fn default_accuracy(which: int) -> [] int {
    if which == 1 {
        return 5;
    }
    return 6;
}

// The last symbol of each kind of code.
fn max_symbol(which: int) -> [] int {
    if which == 0 {
        return 35;
    }
    if which == 1 {
        return 31;
    }
    return 52;
}

fn max_accuracy(which: int) -> [] int {
    if which == 1 {
        return 8;
    }
    return 9;
}

// Fill the baselines and extra-bit counts of the literal length codes (36) and match length codes (53).
fn fill_codes[&a, &b, &c, &d](ll_base: &!a [int], ll_bits: &!b [int], ml_base: &!c [int], ml_bits: &!d [int]) -> [] int {
    var i = 0;
    while i < 16 {
        ll_base[i] = i;
        ll_bits[i] = 0;
        i = i + 1;
    }
    var base = 16;
    while i < 36 {
        var bits = 0;
        if i < 20 {
            bits = 1;
        } else if i < 22 {
            bits = 2;
        } else if i < 24 {
            bits = 3;
        } else if i == 24 {
            bits = 4;
        } else {
            bits = i - 19;
        }
        ll_base[i] = base;
        ll_bits[i] = bits;
        base = base + (1 << bits);
        i = i + 1;
    }
    i = 0;
    while i < 32 {
        ml_base[i] = i + 3;
        ml_bits[i] = 0;
        i = i + 1;
    }
    base = 35;
    while i < 53 {
        var bits = 0;
        if i < 36 {
            bits = 1;
        } else if i < 38 {
            bits = 2;
        } else if i < 40 {
            bits = 3;
        } else if i < 42 {
            bits = 4;
        } else if i == 42 {
            bits = 5;
        } else {
            bits = i - 36;
        }
        ml_base[i] = base;
        ml_bits[i] = bits;
        base = base + (1 << bits);
        i = i + 1;
    }
    return 0;
}

// ---- one compressed block -----------------------------------------------------------------------------------------------------

// The state kept between blocks of a frame, in `st`: [0..2] the three last offsets, [3] 1 once a Huffman table is held, [4] its longest
// code, [5..7] 1 once the literal length, offset and match length tables are held, [8..10] their accuracy logs.

// Decode the literals section at `src[p..end]` into `lits`. Answers a status (0, 1 invalid, 2 truncated), the offset after the
// section, and the number of literals.
fn literals_section[&s, &st, &w, &y, &c, &a, &x, &n, &h, &g, &l](src: &s [byte], p: int, end: int, state: &!st [int], weights: &!w [int], sym: &!y [int], nbits: &!c [int], base: &!a [int], next: &!x [int], norm: &!n [int], hsym: &!h [int], hnb: &!g [int], lits: &!l [byte]) -> [] (int, int, int) {
    if p >= end {
        return (2, p, 0);
    }
    let b0 = int_of(src[p]);
    let kind = b0 & 3;
    let format = b0 >> 2 & 3;
    if kind < 2 {
        var size = b0 >> 3;
        var header = 1;
        if format == 1 {
            if p + 2 > end {
                return (2, p, 0);
            }
            size = b0 >> 4 | int_of(src[p + 1]) << 4;
            header = 2;
        } else if format == 3 {
            if p + 3 > end {
                return (2, p, 0);
            }
            size = b0 >> 4 | int_of(src[p + 1]) << 4 | int_of(src[p + 2]) << 12;
            header = 3;
        }
        if size > 131072 {
            return (1, p, 0);
        }
        if kind == 0 {
            if p + header + size > end {
                return (2, p, 0);
            }
            var i = 0;
            while i < size {
                lits[i] = src[p + header + i];
                i = i + 1;
            }
            return (0, p + header + size, size);
        }
        if p + header + 1 > end {
            return (2, p, 0);
        }
        var i = 0;
        while i < size {
            lits[i] = src[p + header];
            i = i + 1;
        }
        return (0, p + header + 1, size);
    }
    var header = 3;
    var regen = 0;
    var comp = 0;
    var streams = 4;
    if format == 0 || format == 1 {
        if p + 3 > end {
            return (2, p, 0);
        }
        let v = le_n(src, p, 3);
        regen = v >> 4 & 0x3ff;
        comp = v >> 14 & 0x3ff;
        if format == 0 {
            streams = 1;
        }
    } else if format == 2 {
        header = 4;
        if p + 4 > end {
            return (2, p, 0);
        }
        let v = le_n(src, p, 4);
        regen = v >> 4 & 0x3fff;
        comp = v >> 18 & 0x3fff;
    } else {
        header = 5;
        if p + 5 > end {
            return (2, p, 0);
        }
        let v = le_n(src, p, 5);
        regen = v >> 4 & 0x3ffff;
        comp = v >> 22 & 0x3ffff;
    }
    if regen > 131072 {
        return (1, p, 0);
    }
    let section_end = p + header + comp;
    if section_end > end {
        return (2, p, 0);
    }
    var at = p + header;
    if kind == 2 {
        let (used, max_bits) = read_tree(src, at, section_end, weights, sym, nbits, base, next, norm, hsym, hnb);
        if used < 0 {
            return (1, p, 0);
        }
        state[3] = 1;
        state[4] = max_bits;
        at = at + used;
    } else if state[3] == 0 {
        return (1, p, 0);
    }
    let max_bits = state[4];
    if streams == 1 {
        if huffman_stream(src, at, section_end, regen, lits, 0, hsym, hnb, max_bits) != 0 {
            return (1, p, 0);
        }
        return (0, section_end, regen);
    }
    if at + 6 > section_end {
        return (1, p, 0);
    }
    let s1 = le_n(src, at, 2);
    let s2 = le_n(src, at + 2, 2);
    let s3 = le_n(src, at + 4, 2);
    let data = at + 6;
    let s4 = section_end - data - s1 - s2 - s3;
    if s4 < 1 {
        return (1, p, 0);
    }
    let seg = (regen + 3) / 4;
    if 3 * seg > regen {
        return (1, p, 0);
    }
    if huffman_stream(src, data, data + s1, seg, lits, 0, hsym, hnb, max_bits) != 0 || huffman_stream(src, data + s1, data + s1 + s2, seg, lits, seg, hsym, hnb, max_bits) != 0 || huffman_stream(src, data + s1 + s2, data + s1 + s2 + s3, seg, lits, 2 * seg, hsym, hnb, max_bits) != 0 || huffman_stream(src, data + s1 + s2 + s3, section_end, regen - 3 * seg, lits, 3 * seg, hsym, hnb, max_bits) != 0 {
        return (1, p, 0);
    }
    return (0, section_end, regen);
}

// Read the sequences section at `src[p..end]` and run it on `lits[0..lits_len]`, appending to `out` after `made`. `window` is the farthest
// back a match may reach, `room` the most `made` may become. Answers a status (0, 1 invalid, 2 truncated, 3 past `room`) and the new
// `made`.
fn sequences[&s, &st, &y, &c, &a, &x, &n, &l, &o, &lb, &lbb, &mb, &mbb](src: &s [byte], p: int, end: int, state: &!st [int], sym: &!y [int], nbits: &!c [int], base: &!a [int], next: &!x [int], norm: &!n [int], lits: &l [byte], lits_len: int, out: &!o [byte], made_in: int, window: int, room: int, ll_base: &lb [int], ll_bits: &lbb [int], ml_base: &mb [int], ml_bits: &mbb [int]) -> [] (int, int) {
    var made = made_in;
    var at = p;
    var count = 0;
    if at >= end {
        return (2, made);
    }
    let first = int_of(src[at]);
    at = at + 1;
    if first == 0 {
        // No sequences: the literals are the block.
        if made + lits_len > room {
            return (3, made);
        }
        var i = 0;
        while i < lits_len {
            out[made + i] = lits[i];
            i = i + 1;
        }
        return (0, made + lits_len);
    } else if first < 128 {
        count = first;
    } else if first < 255 {
        if at >= end {
            return (2, made);
        }
        count = (first - 128) * 256 + int_of(src[at]);
        at = at + 1;
    } else {
        if at + 2 > end {
            return (2, made);
        }
        count = int_of(src[at]) + int_of(src[at + 1]) * 256 + 0x7f00;
        at = at + 2;
    }
    if at >= end {
        return (2, made);
    }
    let modes = int_of(src[at]);
    at = at + 1;
    if modes & 3 != 0 {
        return (1, made);
    }
    // The three tables, in the order literal lengths, offsets, match lengths (their places in `sym` are 0, 512 and 1024).
    var which = 0;
    while which < 3 {
        let mode = modes >> 6 - 2 * which & 3;
        let off = which * 512;
        if mode == 0 {
            let text = default_norm(which);
            var i = 0;
            while i < len(text) {
                norm[i] = int_of(text[i]) - '0' - 1;
                i = i + 1;
            }
            if build_table(norm, len(text), default_accuracy(which), off, sym, nbits, base, next) != 0 {
                return (1, made);
            }
            state[5 + which] = 1;
            state[8 + which] = default_accuracy(which);
        } else if mode == 1 {
            if at >= end {
                return (2, made);
            }
            let only = int_of(src[at]);
            at = at + 1;
            if only > max_symbol(which) {
                return (1, made);
            }
            build_rle(only, off, sym, nbits, base);
            state[5 + which] = 1;
            state[8 + which] = 0;
        } else if mode == 2 {
            let (al, nsym, used) = read_norm(src, at, end, max_symbol(which), max_accuracy(which), norm);
            if al < 0 || build_table(norm, nsym, al, off, sym, nbits, base, next) != 0 {
                return (1, made);
            }
            at = at + used;
            state[5 + which] = 1;
            state[8 + which] = al;
        } else if state[5 + which] == 0 {
            return (1, made);
        }
        which = which + 1;
    }
    // The bitstream, read backward from its end marker.
    var pos = back_len(src, at, end);
    if pos < 0 {
        return (1, made);
    }
    let al_ll = state[8];
    let al_of = state[9];
    let al_ml = state[10];
    if pos < al_ll + al_of + al_ml {
        return (1, made);
    }
    pos = pos - al_ll;
    var st_ll = bits_at(src, at * 8 + pos, al_ll);
    pos = pos - al_of;
    var st_of = bits_at(src, at * 8 + pos, al_of);
    pos = pos - al_ml;
    var st_ml = bits_at(src, at * 8 + pos, al_ml);
    var lit_at = 0;
    var i = 0;
    var status = 0;
    while i < count && status == 0 {
        let llc = sym[st_ll];
        let ofc = sym[512 + st_of];
        let mlc = sym[1024 + st_ml];
        // Extra bits: offset, match length, literal length.
        if pos < ofc {
            return (1, made);
        }
        pos = pos - ofc;
        let offset_value = (1 << ofc) + bits_at(src, at * 8 + pos, ofc);
        let mb = ml_bits[mlc];
        if pos < mb {
            return (1, made);
        }
        pos = pos - mb;
        let ml = ml_base[mlc] + bits_at(src, at * 8 + pos, mb);
        let lb = ll_bits[llc];
        if pos < lb {
            return (1, made);
        }
        pos = pos - lb;
        let ll = ll_base[llc] + bits_at(src, at * 8 + pos, lb);
        if i + 1 < count {
            // The states move on: literal length, match length, offset.
            let n1 = nbits[st_ll];
            if pos < n1 {
                return (1, made);
            }
            pos = pos - n1;
            st_ll = base[st_ll] + bits_at(src, at * 8 + pos, n1);
            let n2 = nbits[1024 + st_ml];
            if pos < n2 {
                return (1, made);
            }
            pos = pos - n2;
            st_ml = base[1024 + st_ml] + bits_at(src, at * 8 + pos, n2);
            let n3 = nbits[512 + st_of];
            if pos < n3 {
                return (1, made);
            }
            pos = pos - n3;
            st_of = base[512 + st_of] + bits_at(src, at * 8 + pos, n3);
        }
        // The offset: a new one, or one of the last three.
        var offset = 0;
        if offset_value > 3 {
            offset = offset_value - 3;
            state[2] = state[1];
            state[1] = state[0];
            state[0] = offset;
        } else {
            var which_rep = offset_value;
            if ll == 0 {
                which_rep = which_rep + 1;
            }
            if which_rep == 1 {
                offset = state[0];
            } else if which_rep == 2 {
                offset = state[1];
                state[1] = state[0];
                state[0] = offset;
            } else if which_rep == 3 {
                offset = state[2];
                state[2] = state[1];
                state[1] = state[0];
                state[0] = offset;
            } else {
                offset = state[0] - 1;
                if offset == 0 {
                    return (1, made);
                }
                state[2] = state[1];
                state[1] = state[0];
                state[0] = offset;
            }
        }
        // Run it: the literals, then the match.
        if lit_at + ll > lits_len {
            return (1, made);
        }
        if made + ll + ml > room {
            return (3, made);
        }
        var k = 0;
        while k < ll {
            out[made + k] = lits[lit_at + k];
            k = k + 1;
        }
        made = made + ll;
        lit_at = lit_at + ll;
        if offset > made || offset > window {
            return (1, made);
        }
        k = 0;
        while k < ml {
            out[made + k] = out[made + k - offset];
            k = k + 1;
        }
        made = made + ml;
        i = i + 1;
    }
    if pos != 0 {
        return (1, made);
    }
    // What literals the sequences left are the end of the block.
    if made + (lits_len - lit_at) > room {
        return (3, made);
    }
    var k = 0;
    while lit_at + k < lits_len {
        out[made + k] = lits[lit_at + k];
        k = k + 1;
    }
    return (0, made + k);
}

// ---- the frame ---------------------------------------------------------------------------------------------------------------------

// A buffer with room for `need` bytes, holding the `used` it had.
fn grown[&h](heap: &!h Heap, old: Box[[byte]], used: int, need: int) -> [heap] Box[[byte]] {
    var capacity = 0;
    borrow old as &ow in {
        capacity = len(contents(ow));
    }
    if capacity >= need {
        return old;
    }
    var bigger = capacity * 2;
    if bigger < need {
        bigger = need;
    }
    var fresh = box_slice(heap, bigger, byte_of(0));
    borrow mut fresh as &!fw in {
        borrow old as &ow in {
            copy_into(contents(fw)[0..used], contents(ow)[0..used]);
        }
    }
    unbox_slice(heap, old);
    return fresh;
}

// Run the blocks of the frame whose first block header is at `start`. `window` bounds a match's reach. Answers a status, the
// offset after the last block, and how many bytes were made (in `dict`, which is grown as needed).
fn blocks[&h, &s](heap: &!h Heap, src: &s [byte], start: int, window: int, limit: int, dict_in: Box[[byte]]) -> [heap] (int, int, int, Box[[byte]]) {
    var dict = dict_in;
    var made = 0;
    var p = start;
    var status = 0;
    var last = false;
    var biggest = 131072;
    if window < biggest {
        biggest = window;
    }
    let lits_box = box_slice(heap, 131072, byte_of(0));
    let state_box = box_slice(heap, 16, 0);
    let weights_box = box_slice(heap, 256, 0);
    let sym_box = box_slice(heap, 2048, 0);
    let nbits_box = box_slice(heap, 2048, 0);
    let base_box = box_slice(heap, 2048, 0);
    let next_box = box_slice(heap, 64, 0);
    let norm_box = box_slice(heap, 64, 0);
    let hsym_box = box_slice(heap, 2048, 0);
    let hnb_box = box_slice(heap, 2048, 0);
    let llb_box = box_slice(heap, 64, 0);
    let llbits_box = box_slice(heap, 64, 0);
    let mlb_box = box_slice(heap, 64, 0);
    let mlbits_box = box_slice(heap, 64, 0);
    borrow mut lits_box as &!lw in {
        borrow mut state_box as &!stw in {
            borrow mut weights_box as &!ww in {
                borrow mut sym_box as &!yw in {
                    borrow mut nbits_box as &!cw in {
                        borrow mut base_box as &!aw in {
                            borrow mut next_box as &!xw in {
                                borrow mut norm_box as &!nw in {
                                    borrow mut hsym_box as &!hw in {
                                        borrow mut hnb_box as &!gw in {
                                            borrow mut llb_box as &!lbw in {
                                                borrow mut llbits_box as &!lbbw in {
                                                    borrow mut mlb_box as &!mbw in {
                                                        borrow mut mlbits_box as &!mbbw in {
                                                            let lits = contents(lw);
                                                            let state = contents(stw);
                                                            let weights = contents(ww);
                                                            let sym = contents(yw);
                                                            let nbits = contents(cw);
                                                            let base = contents(aw);
                                                            let next = contents(xw);
                                                            let norm = contents(nw);
                                                            let hsym = contents(hw);
                                                            let hnb = contents(gw);
                                                            let llb = contents(lbw);
                                                            let llbits = contents(lbbw);
                                                            let mlb = contents(mbw);
                                                            let mlbits = contents(mbbw);
                                                            fill_codes(llb, llbits, mlb, mlbits);
                                                            state[0] = 1;
                                                            state[1] = 4;
                                                            state[2] = 8;
                                                            while !last && status == 0 {
                                                                if p + 3 > len(src) {
                                                                    status = 2;
                                                                } else {
                                                                    let head = le_n(src, p, 3);
                                                                    p = p + 3;
                                                                    last = head & 1 == 1;
                                                                    let kind = head >> 1 & 3;
                                                                    let size = head >> 3;
                                                                    if kind == 3 || size > biggest {
                                                                        status = 1;
                                                                    } else if kind == 0 {
                                                                        if p + size > len(src) {
                                                                            status = 2;
                                                                        } else if made + size > limit {
                                                                            status = 3;
                                                                        } else {
                                                                            dict = grown(heap, dict, made, made + size);
                                                                            borrow mut dict as &!dw in {
                                                                                copy_into(contents(dw)[made..made + size], src[p..p + size]);
                                                                            }
                                                                            made = made + size;
                                                                            p = p + size;
                                                                        }
                                                                    } else if kind == 1 {
                                                                        if p + 1 > len(src) {
                                                                            status = 2;
                                                                        } else if made + size > limit {
                                                                            status = 3;
                                                                        } else {
                                                                            dict = grown(heap, dict, made, made + size);
                                                                            let value = src[p];
                                                                            borrow mut dict as &!dw in {
                                                                                let d = contents(dw);
                                                                                var i = 0;
                                                                                while i < size {
                                                                                    d[made + i] = value;
                                                                                    i = i + 1;
                                                                                }
                                                                            }
                                                                            made = made + size;
                                                                            p = p + 1;
                                                                        }
                                                                    } else if p + size > len(src) {
                                                                        status = 2;
                                                                    } else {
                                                                        let end = p + size;
                                                                        let (why, after, lits_len) = literals_section(src, p, end, state, weights, sym, nbits, base, next, norm, hsym, hnb, lits);
                                                                        if why != 0 {
                                                                            status = why;
                                                                        } else {
                                                                            var room = made + 131072;
                                                                            if room > limit {
                                                                                room = limit;
                                                                            }
                                                                            dict = grown(heap, dict, made, room);
                                                                            var made_after = made;
                                                                            borrow mut dict as &!dw in {
                                                                                let (why2, m) = sequences(src, after, end, state, sym, nbits, base, next, norm, lits, lits_len, contents(dw), made, window, room, llb, llbits, mlb, mlbits);
                                                                                status = why2;
                                                                                made_after = m;
                                                                            }
                                                                            if status == 3 && room < limit {
                                                                                // The block alone would be larger than a block may be.
                                                                                status = 1;
                                                                            }
                                                                            if status == 0 {
                                                                                made = made_after;
                                                                                p = end;
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, lits_box);
    unbox_slice(heap, state_box);
    unbox_slice(heap, weights_box);
    unbox_slice(heap, sym_box);
    unbox_slice(heap, nbits_box);
    unbox_slice(heap, base_box);
    unbox_slice(heap, next_box);
    unbox_slice(heap, norm_box);
    unbox_slice(heap, hsym_box);
    unbox_slice(heap, hnb_box);
    unbox_slice(heap, llb_box);
    unbox_slice(heap, llbits_box);
    unbox_slice(heap, mlb_box);
    unbox_slice(heap, mlbits_box);
    return (status, p, made, dict);
}

// Decompress the zstd frame that is all of `src`, producing at most `limit` bytes. Answers the output and a status.
pub fn decompress[&h, &s](heap: &!h Heap, src: &s [byte], limit: int) -> [heap] (buffer.Buffer, int) {
    var out = buffer.empty(heap, 4096);
    if !looks_like(src) {
        return (out, 10);
    }
    let n = len(src);
    if n < 6 {
        return (out, 2);
    }
    let descriptor = int_of(src[4]);
    if descriptor & 8 != 0 {
        return (out, 1);
    }
    let size_flag = descriptor >> 6;
    let single = descriptor >> 5 & 1 == 1;
    let checksummed = descriptor >> 2 & 1 == 1;
    let id_flag = descriptor & 3;
    var p = 5;
    var window = 0;
    if !single {
        let w = int_of(src[p]);
        p = p + 1;
        let floor = 1 << 10 + (w >> 3);
        window = floor + floor / 8 * (w & 7);
    }
    var id_size = 0;
    if id_flag == 1 {
        id_size = 1;
    } else if id_flag == 2 {
        id_size = 2;
    } else if id_flag == 3 {
        id_size = 4;
    }
    var content_size = 0 - 1;
    var size_size = 0;
    if size_flag == 0 {
        if single {
            size_size = 1;
        }
    } else if size_flag == 1 {
        size_size = 2;
    } else if size_flag == 2 {
        size_size = 4;
    } else {
        size_size = 8;
    }
    if p + id_size + size_size > n {
        return (out, 2);
    }
    if id_size > 0 && le_n(src, p, id_size) != 0 {
        return (out, 11);
    }
    p = p + id_size;
    if size_size > 0 {
        content_size = le_n(src, p, size_size);
        if size_size == 2 {
            content_size = content_size + 256;
        }
        p = p + size_size;
        if content_size < 0 || content_size > limit {
            return (out, 3);
        }
        if single {
            window = content_size;
        }
    }
    if window < 1 {
        window = 1;
    }
    var dict = box_slice(heap, 65536, byte_of(0));
    let (status, after, made, grown_dict) = blocks(heap, src, p, window, limit, dict);
    dict = grown_dict;
    var result = status;
    var end = after;
    if result == 0 && content_size >= 0 && content_size != made {
        result = 1;
    }
    if result == 0 && checksummed {
        if end + 4 > n {
            result = 2;
        } else {
            var same = false;
            borrow dict as &dr in {
                same = xxh64(contents(dr)[0..made]) & 0xffffffff == le_n(src, end, 4);
            }
            if !same {
                result = 13;
            }
            end = end + 4;
        }
    }
    if result == 0 && end != n {
        result = 15;
    }
    borrow dict as &dr in {
        out = buffer.append(heap, out, contents(dr)[0..made]);
    }
    unbox_slice(heap, dict);
    return (out, result);
}
