edition 7;

// `move` -- rename a file or directory in place, and never over anything.
//
//     move [--root DIR] [--if-sha256 HEX] [--dry-run] [--format json|text] PATH NEWNAME
//
// `docs/next-tools.md` §4. The benchmark's `bash` transcripts show agents
// reaching for `mv` and nothing here did what it does; `mv` is also blind in
// the way `sed -i` and `>` are: it replaces an existing destination without a
// word.
//
// * **One directory.** NEWNAME is one component (`path.bad-name` otherwise):
//   `dir_rename_new` works on one directory handle, so a move to another
//   directory is not something this tool can do, and it does not pretend to
//   (cancho `docs/directory-handles.md`).
// * **Never over anything, by the kernel.** An existing destination is
//   `conflict.exists` and nothing changes. POSIX `renameat` would replace it
//   silently, so the rename is `dir_rename_new` (Linux `renameat2` with
//   `RENAME_NOREPLACE`, macOS `renameatx_np` with `RENAME_EXCL`): the check
//   and the rename are one call, so a process that takes no lock and creates
//   the destination at any moment is refused by the kernel, not overwritten
//   (`scripts/move_race.py`: 55 of 20,000 random-arrival trials and 100 of 100
//   delayed ones lost the creator's file with `dir_rename`; none with this).
//   The look under the lock stays, but only for what the kernel cannot give:
//   the refusal before anything is attempted (`--dry-run` makes no mutating
//   call), and the landed-retry of `--if-sha256`. Two toolbox processes also
//   cannot interleave there (`tests/conformance/test_move.py`). A filesystem
//   that cannot refuse atomically (NFS, ntfs-3g and ExFAT answer so for a free
//   name) is `io.rename-unsupported`: the tool never falls back to a replacing rename.
// * **`--if-sha256`** says the file is what the caller read
//   (`precondition.hash-mismatch`), and makes a retry safe: when the source is
//   gone and the destination holds exactly that content, the move had landed,
//   and the answer is `changed: false`, exit 0.
// * **Locked, atomic.** Both names are locked (`<name>.lexsys-lock`, as
//   `write`'s) from before the look until after the rename; the rename is one
//   `renameat2`/`renameatx_np` that refuses an existing name. `--dry-run` takes no lock and makes no mutating call.
// * **No link is followed.** The directory holding the file is opened
//   beneath --root with no link followed (`toolbox.place`), and a link is
//   renamed as itself, never its target (`dir_rename_new` takes the entry).
//
// * **`--remove`** is the one deletion the toolbox offers, and it deletes nothing:
//   `move --remove --if-sha256 HEX PATH` renames the file to its tombstone,
//   `.<name>.removed-<first 8 hex of HEX>`, in the same directory. It needs the
//   hash (`args.required-flag` without it), only a regular file has one, and
//   every guard above holds -- a taken tombstone is `conflict.exists`, a retry
//   that had landed is `changed: false`. Nothing purges a tombstone; moving it
//   back undoes the removal (D15, as amended in `docs/next-tools.md`).
//
// No tool deletes (D15), and this one does not either, even with --remove: it moves a name, and
// every move can be undone by moving it back.

import std.buffer;
import std.bytes;
import std.dirs;
import std.json;
import toolbox.atomic;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.place;
import toolbox.text;

fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve PATH relative to this directory and refuse paths outside it;if-sha256||hex64|guard||the file's current content must hash to this SHA-256, and a retry that already landed then answers changed: false;remove||bool|guard||remove the file by renaming it to its tombstone .NAME.removed-HASH8 (needs --if-sha256, takes no NEWNAME, and nothing is deleted);dry-run||bool|guard||check everything and report planned_actions, exit 9, change nothing;format||choice:json/text|none|json|json for a program, text for a person";
}

// The one rule only `move` has (`describe.Tool.extra_rules`): the filesystem cannot rename without replacing.
fn extra_rules() -> [] &static [byte] {
    return "io.rename-unsupported|8|never|the filesystem cannot refuse an existing name atomically, so move did not rename";
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "move", version: "0.1.0", summary: "Rename a file or directory in place, never over an existing name (the kernel refuses it, even if another process creates it mid-move); locked, atomic, idempotent with --if-sha256, with --dry-run. One directory: a move to another is not offered. With --remove and --if-sha256, a file is removed by renaming it to a tombstone, and nothing is deleted.", usage: "move [--root DIR] [--if-sha256 HEX] [--dry-run] [--format json|text] PATH NEWNAME | move --remove --if-sha256 HEX [--root DIR] [--dry-run] PATH", output: "document", schema: "move.v1", flags: flag_table(), operands: "PATH|path-write|1|1|the file or directory to rename;NEWNAME|none|0|1|its new name: one component, in the same directory, and not one that exists, and none with --remove", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.unexpected-value;args.duplicate-flag;args.required-flag;args.missing-operand;args.too-many-operands;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;path.bad-name;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;io.write-failed;precondition.hash-mismatch;conflict.exists;conflict.locked;io.rename-unsupported", extra_rules: extra_rules(), limits: "", reversibility: "irreversible-bounded", stdin: "no", guarantees: "deterministic;idempotent;atomic;dry_run" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn flag_problem[&h](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &static [byte], hint: &static [byte], flags: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open(heap, rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_str(heap, w, "flags", flags);
    return fail.add(heap, e, w);
}

// What happened, for the data object and the text line.
struct Outcome {
    changed: bool,
    planned: bool,
    found: int,
}

fn no_outcome() -> [] Outcome {
    return Outcome { changed: false, planned: false, found: 0 - 1 };
}

fn kind_name(found: int) -> [] &static [byte] {
    if found == dirs.kind_file() {
        return "file";
    }
    if found == dirs.kind_directory() {
        return "directory";
    }
    if found == dirs.kind_link() {
        return "link";
    }
    return "other";
}

// A name that is not one component of the same directory, or that would be
// taken for a lock sidecar.
fn bad_name[&n](name: &n [byte]) -> [] bool {
    // The longest a name can be and still have its `.lexsys-lock` sidecar (12 bytes) inside
    // the filesystem's 255: a longer one cannot be locked, so it is refused up front.
    if len(name) == 0 || len(name) > 243 {
        return true;
    }
    if bytes.equal(name, ".") || bytes.equal(name, "..") {
        return true;
    }
    if bytes.count_byte(name, '/') > 0 {
        return true;
    }
    if len(name) >= 12 && bytes.equal(name[len(name) - 12..len(name)], ".lexsys-lock") {
        return true;
    }
    return false;
}

// The destination as the caller names paths: the source's directory part, then NEWNAME.
fn destination[&h, &p, &n](heap: &!h Heap, from_shown: &p [byte], newname: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, len(from_shown) + len(newname) + 2);
    let parent = place.parent_of(from_shown);
    if !bytes.equal(parent, ".") {
        b = buffer.append(heap, b, parent);
        if !bytes.equal(parent, "/") {
            b = buffer.append(heap, b, "/");
        }
    }
    return buffer.append(heap, b, newname);
}

// `.NAME.removed-HASH8`: the tombstone a removal renames the file to.
fn tombstone[&h, &n, &x](heap: &!h Heap, leaf: &n [byte], hex: &x [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, len(leaf) + 20);
    b = buffer.append(heap, b, ".");
    b = buffer.append(heap, b, leaf);
    b = buffer.append(heap, b, ".removed-");
    return buffer.append(heap, b, hex[0..8]);
}

fn data[&h, &p, &t, &x](heap: &!h Heap, from_shown: &p [byte], to_shown: &t [byte], o: Outcome, sha: &x [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 192);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "path");
    w = text.put(heap, w, from_shown);
    w = json.put_key(heap, w, "to");
    w = text.put(heap, w, to_shown);
    w = json.put_key(heap, w, "changed");
    w = json.put_bool(heap, w, o.changed);
    w = json.put_key(heap, w, "kind");
    w = json.put_string(heap, w, kind_name(o.found));
    w = json.put_key(heap, w, "sha256");
    if len(sha) == 0 {
        w = json.put_null(heap, w);
    } else {
        w = json.put_string(heap, w, sha);
    }
    w = json.end_object(heap, w);
    return json.finish(w);
}

fn planned[&h, &p, &t, &x](heap: &!h Heap, from_shown: &p [byte], to_shown: &t [byte], o: Outcome, sha: &x [byte], op: &static [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 192);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "dry_run");
    w = json.put_bool(heap, w, true);
    w = json.put_key(heap, w, "planned_actions");
    w = json.begin_array(heap, w);
    if o.planned {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "op");
        w = json.put_string(heap, w, op);
        w = json.put_key(heap, w, "path");
        w = text.put(heap, w, from_shown);
        w = json.put_key(heap, w, "to");
        w = text.put(heap, w, to_shown);
        w = json.put_key(heap, w, "kind");
        w = json.put_string(heap, w, kind_name(o.found));
        w = json.put_key(heap, w, "sha256");
        if len(sha) == 0 {
            w = json.put_null(heap, w);
        } else {
            w = json.put_string(heap, w, sha);
        }
        w = json.end_object(heap, w);
    }
    w = json.end_array(heap, w);
    w = json.end_object(heap, w);
    // The members, without the braces: `toolbox.out` splices them into the
    // envelope beside `data`, after a comma.
    let whole = json.finish(w);
    var inner = buffer.empty(heap, 192);
    borrow whole as &r in {
        let b = buffer.bytes(r);
        inner = buffer.push(heap, inner, byte_of(','));
        inner = buffer.append(heap, inner, b[1..len(b) - 1]);
    }
    buffer.drop(heap, whole);
    return inner;
}

// The new name is taken: the look found it, or the kernel refused the rename (`EEXIST`). One refusal, either way.
fn name_taken[&h, &p, &z](heap: &!h Heap, e: fail.Errors, from_shown: &p [byte], to_shown: &z [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra_rules(), "conflict.exists", "the new name is taken, and move never replaces a name", "choose another name, or look at what is there first");
    w = fail.repair_none(heap, w, "whether to replace what is there is a decision, not a retry");
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", from_shown);
    w = fail.detail_text(heap, w, "to", to_shown);
    return fail.add(heap, e, w);
}

// The filesystem answered `EOPNOTSUPP` (Linux, 95) or `ENOTSUP` (macOS, 45): it cannot rename without
// replacing, and `dir_rename_new` has no fallback. The kernel answers a taken name `EEXIST` first, so this is
// only ever a name that was free.
fn rename_unsupported[&h, &p, &z](heap: &!h Heap, e: fail.Errors, from_shown: &p [byte], to_shown: &z [byte], errno: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra_rules(), "io.rename-unsupported", "this filesystem cannot rename without replacing, and move never replaces a name; nothing was moved", "rename within a filesystem that supports it (ext4, XFS, Btrfs, tmpfs, APFS), or check the name yourself and use a shell");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", from_shown);
    w = fail.detail_text(heap, w, "to", to_shown);
    w = fail.detail_int(heap, w, "errno", errno);
    return fail.add(heap, e, w);
}

// What `dir_stat` said about a name: its kind, or -1 and the errno.
fn look[&f, &n](dir: &f Dir, name: &n [byte]) -> [dir_read] (int, int) {
    match dir_stat(dir, name) {
        DirStat::Ok(found, held, seconds) => {
            return (found, 0);
        }
        DirStat::Failed(reason) => {
            return (0 - 1, reason);
        }
    }
}

// The hash of the file `name`, as hex, and the errno (0 for none).
fn hash_of[&h, &f, &n](heap: &!h Heap, dir: &f Dir, name: &n [byte]) -> [heap, dir_read, file_read] (buffer.Buffer, int) {
    let (hex, errno, size) = atomic.hash_file(heap, dir_open_read(dir, name));
    return (hex, errno);
}

// The directory is open, and the lock held unless this is a dry run: look, check, move.
fn apply[&h, &g, &p, &f, &s, &t, &q, &z](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, dir: &f Dir, name: &s [byte], newname: &t [byte], from_shown: &q [byte], to_shown: &z [byte], errs: fail.Errors) -> [heap, args, dir_read, file_read, dir_write] (fail.Errors, Outcome, buffer.Buffer) {
    let table = flag_table();
    var e = errs;
    var o = no_outcome();
    var sha = buffer.empty(heap, 64);
    let guarded = cli.has(parsed, table, "if-sha256");
    let dry = cli.has(parsed, table, "dry-run");
    let (src_kind, src_errno) = look(dir, name);
    let (dst_kind, dst_errno) = look(dir, newname);
    var go = false;

    if src_errno == 2 {
        // The source is gone. With a hash, a destination holding exactly that
        // content means the move had already landed (D10, as `write`'s retry).
        var landed = false;
        if guarded && dst_errno == 0 && dst_kind == dirs.kind_file() {
            let (there, there_errno) = hash_of(heap, dir, newname);
            if there_errno == 0 {
                borrow there as &tb in {
                    landed = bytes.equal(buffer.bytes(tb), cli.text(args, parsed, table, "if-sha256"));
                    if landed {
                        buffer.drop(heap, sha);
                        sha = buffer.empty(heap, 64);
                        sha = buffer.append(heap, sha, buffer.bytes(tb));
                    }
                }
            }
            buffer.drop(heap, there);
        }
        if landed {
            o = Outcome { changed: false, planned: false, found: dirs.kind_file() };
        } else {
            e = fail.io_error(heap, e, 2, true, from_shown);
        }
    } else if src_errno != 0 {
        e = fail.io_error(heap, e, src_errno, true, from_shown);
    } else if guarded && src_kind != dirs.kind_file() {
        // A hash is of a regular file's content, and nothing else is opened to find one: a
        // directory has none, a link is not followed, and opening a FIFO or a device would
        // wait for a peer. Each is refused by what it is, before any `open`.
        var why = 22;
        if src_kind == dirs.kind_directory() {
            why = 21;
        } else if src_kind == dirs.kind_link() {
            why = 40;
        }
        e = fail.io_error(heap, e, why, false, from_shown);
    } else {
        var matches = true;
        if guarded {
            let (here, here_errno) = hash_of(heap, dir, name);
            if here_errno != 0 {
                e = fail.io_error(heap, e, here_errno, false, from_shown);
                matches = false;
            } else {
                borrow here as &hb in {
                    buffer.drop(heap, sha);
                    sha = buffer.empty(heap, 64);
                    sha = buffer.append(heap, sha, buffer.bytes(hb));
                    if !bytes.equal(buffer.bytes(hb), cli.text(args, parsed, table, "if-sha256")) {
                        var w = fail.open(heap, "precondition.hash-mismatch", "the file does not hold the content --if-sha256 named", "re-read the file, then decide");
                        w = fail.repair_none(heap, w, "the file changed since it was read; re-read, then decide");
                        w = fail.detail_open(heap, w);
                        w = fail.detail_text(heap, w, "path", from_shown);
                        w = fail.detail_str(heap, w, "expected_sha256", cli.text(args, parsed, table, "if-sha256"));
                        w = fail.detail_str(heap, w, "actual_sha256", buffer.bytes(hb));
                        e = fail.add(heap, e, w);
                        matches = false;
                    }
                }
            }
            buffer.drop(heap, here);
        }
        if matches {
            o = Outcome { changed: false, planned: false, found: src_kind };
            if bytes.equal(name, newname) {
                // Already where it is to be: nothing to do.
            } else if dst_errno == 0 {
                e = name_taken(heap, e, from_shown, to_shown);
            } else if dst_errno != 2 {
                e = fail.io_error(heap, e, dst_errno, true, to_shown);
            } else {
                go = true;
            }
        }
    }

    if go && dry {
        o = Outcome { changed: false, planned: true, found: o.found };
    } else if go {
        var failed = 0;
        match dir_rename_new(dir, name, newname) {
            Done::Ok(n) => {
            }
            Done::Failed(reason) => {
                failed = reason;
                if failed == 0 {
                    failed = 5;
                }
            }
        }
        if failed == 17 {
            // The destination appeared after the look: made by a process that takes no lock. The kernel
            // refused, and the name and the source are as they were.
            e = name_taken(heap, e, from_shown, to_shown);
        } else if failed == 95 || failed == 45 {
            e = rename_unsupported(heap, e, from_shown, to_shown, failed);
        } else if failed != 0 {
            var w = fail.open(heap, fail.io_rule(failed, true), "the rename failed; nothing was moved", "");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "path", from_shown);
            w = fail.detail_int(heap, w, "errno", failed);
            e = fail.add(heap, e, w);
        } else {
            atomic.sync_parent(dir);
            o = Outcome { changed: true, planned: false, found: o.found };
        }
    }
    return (e, o, sha);
}

// The source's own name is too long for its sidecar: a limit of the lock, said as one. The kernel's answer is
// `ENAMETOOLONG` (36), but cancho's `dir_open_append` refuses a name over 255 bytes itself, with `EINVAL` (22);
// the name here is the tool's own (`<name>.lexsys-lock`), so neither can mean anything else.
fn name_too_long[&h, &q](heap: &!h Heap, e: fail.Errors, shown_path: &q [byte]) -> [heap] fail.Errors {
    return fail.simple(heap, e, "path.too-long", "the name is too long to lock: this tool moves names of up to 243 bytes", "rename it with a shell, or give it a shorter name first", "path", shown_path);
}

fn conflict_locked[&h, &q](heap: &!h Heap, e: fail.Errors, shown_path: &q [byte]) -> [heap] fail.Errors {
    var w = fail.open(heap, "conflict.locked", "another writer holds this file's lock", "retry after it finishes, then look at the file again");
    w = fail.repair_none(heap, w, "another writer is changing this file; look again after that writer finishes");
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", shown_path);
    return fail.add(heap, e, w);
}

// Take both names' locks (neither blocks: a holder is `conflict.locked`, so two
// movers cannot wait on each other), then apply, then let go.
fn locked[&h, &g, &p, &f, &s, &t, &q, &z](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, dir: &f Dir, name: &s [byte], newname: &t [byte], from_shown: &q [byte], to_shown: &z [byte], errs: fail.Errors) -> [heap, args, dir_read, file_read, dir_write, file_write] (fail.Errors, Outcome, buffer.Buffer) {
    if cli.has(parsed, flag_table(), "dry-run") {
        return apply(heap, args, parsed, dir, name, newname, from_shown, to_shown, errs);
    }
    var e = errs;
    var o = no_outcome();
    var sha = buffer.empty(heap, 1);
    match atomic.acquire(heap, dir, name) {
        Opened::Failed(reason) => {
            if atomic.would_block(reason) {
                e = conflict_locked(heap, e, from_shown);
            } else if reason == 36 || reason == 22 {
                e = name_too_long(heap, e, from_shown);
            } else {
                e = fail.io_error(heap, e, reason, true, from_shown);
            }
        }
        Opened::Ok(source_lock) => {
            if bytes.equal(name, newname) {
                buffer.drop(heap, sha);
                let (applied, outcome, digest) = apply(heap, args, parsed, dir, name, newname, from_shown, to_shown, e);
                e = applied;
                o = outcome;
                sha = digest;
            } else {
                match atomic.acquire(heap, dir, newname) {
                    Opened::Failed(reason) => {
                        if atomic.would_block(reason) {
                            e = conflict_locked(heap, e, to_shown);
                        } else if reason == 36 || reason == 22 {
                            e = name_too_long(heap, e, to_shown);
                        } else {
                            e = fail.io_error(heap, e, reason, true, to_shown);
                        }
                    }
                    Opened::Ok(target_lock) => {
                        buffer.drop(heap, sha);
                        let (applied, outcome, digest) = apply(heap, args, parsed, dir, name, newname, from_shown, to_shown, e);
                        e = applied;
                        o = outcome;
                        sha = digest;
                        file_close(target_lock);
                    }
                }
            }
            // Closing the descriptors releases the locks.
            file_close(source_lock);
        }
    }
    return (e, o, sha);
}

// Open the directory that holds the file -- beneath --root when one is given
// (`toolbox.place`) -- so no step follows a link in the file's own name.
fn beneath[&h, &g, &p, &f, &r, &s, &u, &t, &w](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], full: &s [byte], from_shown: &u [byte], newname: &t [byte], to_shown: &w [byte], errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read, dir_write, file_write] (fail.Errors, Outcome, buffer.Buffer) {
    var e = errs;
    let name = place.leaf(full);
    if place.is_directory_name(name) {
        e = fail.io_error(heap, e, 21, true, from_shown);
        return (e, no_outcome(), buffer.empty(heap, 1));
    }
    match place.parent(fs, root, from_shown, full) {
        DirOpened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, true, from_shown);
            return (e, no_outcome(), buffer.empty(heap, 1));
        }
        DirOpened::Ok(opened) => {
            var dir = opened;
            var o = no_outcome();
            var sha = buffer.empty(heap, 1);
            borrow dir as &d in {
                buffer.drop(heap, sha);
                let (applied, outcome, digest) = locked(heap, args, parsed, d, name, newname, from_shown, to_shown, e);
                e = applied;
                o = outcome;
                sha = digest;
            }
            dir_close(dir);
            return (e, o, sha);
        }
    }
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read, dir_write, file_write, io_write, err_write] int {
    let table = flag_table();
    var e = errs;
    let text_mode = bytes.equal(cli.text(args, parsed, table, "format"), "text");
    let (root, after_root) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e);
    e = after_root;
    let removing = cli.has(parsed, table, "remove");
    var operands_ok = false;
    if removing {
        if !cli.has(parsed, table, "if-sha256") {
            e = flag_problem(heap, e, "args.required-flag", "--remove needs --if-sha256: a file is removed only as the caller read it", "read the file's hash first, then pass it", "--if-sha256");
        } else if cli.operand_count(parsed) < 1 {
            e = flag_problem(heap, e, "args.missing-operand", "move --remove takes the PATH to remove", "move --remove --if-sha256 HEX PATH", "PATH");
        } else if cli.operand_count(parsed) > 1 {
            e = flag_problem(heap, e, "args.too-many-operands", "move --remove takes one PATH and no NEWNAME: the tombstone's name is derived", "move --remove --if-sha256 HEX PATH", "PATH");
        } else {
            operands_ok = true;
        }
    } else if cli.operand_count(parsed) < 2 {
        e = flag_problem(heap, e, "args.missing-operand", "move takes the PATH to rename and its NEWNAME", "move PATH NEWNAME", "PATH NEWNAME");
    } else if cli.operand_count(parsed) > 2 {
        e = flag_problem(heap, e, "args.too-many-operands", "move takes one PATH and one NEWNAME", "move one name per call", "PATH NEWNAME");
    } else {
        operands_ok = true;
    }
    var newname: &static [byte] = "";
    if operands_ok && !removing {
        newname = cli.operand(args, parsed, 1);
        if bad_name(newname) {
            var w = fail.open(heap, "path.bad-name", "NEWNAME must be one name in the same directory: 1 to 243 bytes, not . or .., no /, not a lock sidecar", "give a bare name; to move to another directory is not something this tool does");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "newname", newname);
            e = fail.add(heap, e, w);
            operands_ok = false;
        }
    }

    var o = no_outcome();
    var from_copy = buffer.empty(heap, 64);
    var to_copy = buffer.empty(heap, 64);
    var sha = buffer.empty(heap, 1);
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    if !refused && operands_ok {
        borrow root as &rr in {
            let (target, checked) = path.operand(heap, args, buffer.bytes(rr), cli.operand_index(parsed, 0), e);
            e = checked;
            borrow target as &tp in {
                from_copy = buffer.append(heap, from_copy, path.shown(tp));
                if path.ok(tp) {
                    // The name to rename to: NEWNAME, or the tombstone `--remove` derives.
                    var chosen = buffer.empty(heap, len(newname) + 1);
                    var fits = true;
                    if removing {
                        buffer.drop(heap, chosen);
                        chosen = tombstone(heap, place.leaf(path.full(tp)), cli.text(args, parsed, table, "if-sha256"));
                        borrow chosen as &cb in {
                            if bad_name(buffer.bytes(cb)) {
                                e = name_too_long(heap, e, path.shown(tp));
                                fits = false;
                            }
                        }
                    } else {
                        chosen = buffer.append(heap, chosen, newname);
                    }
                    if fits {
                        buffer.drop(heap, to_copy);
                        borrow chosen as &cb in {
                            to_copy = destination(heap, path.shown(tp), buffer.bytes(cb));
                            borrow to_copy as &dc in {
                                let (applied, outcome, digest) = beneath(heap, args, parsed, fs, buffer.bytes(rr), path.full(tp), path.shown(tp), buffer.bytes(cb), buffer.bytes(dc), e);
                                e = applied;
                                o = outcome;
                                buffer.drop(heap, sha);
                                sha = digest;
                            }
                        }
                    }
                    buffer.drop(heap, chosen);
                }
            }
            path.drop(heap, target);
        }
    }
    buffer.drop(heap, root);

    var status = 0;
    borrow e as &er in {
        borrow from_copy as &fc in {
            borrow to_copy as &tc in {
                borrow sha as &sh in {
                    var payload = buffer.empty(heap, 1);
                    var extra = buffer.empty(heap, 1);
                    var line = buffer.empty(heap, 64);
                    if fail.count(er) == 0 {
                        buffer.drop(heap, payload);
                        payload = data(heap, buffer.bytes(fc), buffer.bytes(tc), o, buffer.bytes(sh));
                        if cli.has(parsed, table, "dry-run") {
                            buffer.drop(heap, extra);
                            var op: &static [byte] = "move";
                            if removing {
                                op = "remove";
                            }
                            extra = planned(heap, buffer.bytes(fc), buffer.bytes(tc), o, buffer.bytes(sh), op);
                            line = buffer.append(heap, line, "dry run: ");
                        }
                        if o.changed {
                            if removing {
                                line = buffer.append(heap, line, "removed (tombstoned) ");
                            } else {
                                line = buffer.append(heap, line, "moved ");
                            }
                        } else if o.planned {
                            if removing {
                                line = buffer.append(heap, line, "would remove (tombstone) ");
                            } else {
                                line = buffer.append(heap, line, "would move ");
                            }
                        } else {
                            line = buffer.append(heap, line, "unchanged ");
                        }
                        line = buffer.append(heap, line, buffer.bytes(fc));
                        line = buffer.append(heap, line, " -> ");
                        line = buffer.append(heap, line, buffer.bytes(tc));
                        line = buffer.append(heap, line, "\n");
                    }
                    var success = 0;
                    if cli.has(parsed, table, "dry-run") {
                        success = 9;
                    }
                    borrow payload as &d in {
                        borrow extra as &x in {
                            borrow line as &l in {
                                status = out.respond(heap, io, "move", "move.v1", "0.1.0", buffer.bytes(d), buffer.bytes(x), er, text_mode, buffer.bytes(l), success);
                            }
                        }
                    }
                    buffer.drop(heap, payload);
                    buffer.drop(heap, extra);
                    buffer.drop(heap, line);
                }
            }
        }
    }
    buffer.drop(heap, from_copy);
    buffer.drop(heap, to_copy);
    buffer.drop(heap, sha);
    fail.drop(heap, e);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, file_read, dir_write, file_write, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, extra_rules()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    // No foreign code, no network, no clock, no signals, no programs started.
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
